<div class="flex flex-wrap justify-between items-start gap-2 mb-4">
  <div>
    <h1 class="text-2xl font-bold">Skill review</h1>
    <p class="text-sm text-slate-500">Workflows the team keeps repeating, waiting to become documented skills.</p>
  </div>
  <%= link_to "Request a skill", new_skill_candidate_path, class: "bg-slate-900 text-white px-3 py-1.5 rounded text-sm" %>
</div>

<div class="grid grid-cols-2 md:grid-cols-5 gap-2 mb-4 text-sm">
  <% [["Open", @metrics[:open]], ["Detected (all time)", @metrics[:detected]], ["Published skills", @metrics[:published_skills]],
      ["Approval rate", @metrics[:conversion_rate] ? number_to_percentage(@metrics[:conversion_rate] * 100, precision: 0) : "—"],
      ["Median hrs to approve", @metrics[:median_hours_to_approval] || "—"]].each do |label, value| %>
    <div class="bg-white border rounded p-3">
      <div class="text-xs text-slate-500"><%= label %></div>
      <div class="text-xl font-semibold"><%= value %></div>
    </div>
  <% end %>
</div>

<div class="flex flex-wrap gap-1 mb-3 text-sm">
  <% (%w[open] + SkillCandidate::STATUSES + %w[all]).uniq.each do |s| %>
    <%= link_to s.humanize, skill_candidates_path(status: s),
          class: "px-2 py-1 rounded border #{@status == s ? 'bg-slate-900 text-white' : 'bg-white'}" %>
  <% end %>
</div>

<div class="bg-white rounded shadow-sm border overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-100 text-slate-700">
      <tr>
        <th class="px-3 py-2 text-left">Workflow</th>
        <th class="px-3 py-2 text-left">Area</th>
        <th class="px-3 py-2 text-right">Seen</th>
        <th class="px-3 py-2 text-right">People</th>
        <th class="px-3 py-2 text-left">Last seen</th>
        <th class="px-3 py-2 text-left">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      <% @candidates.each do |c| %>
        <tr>
          <td class="px-3 py-2">
            <%= link_to c.display_title, skill_candidate_path(c), class: "text-sky-700 hover:underline font-medium" %>
            <div class="text-xs text-slate-500"><%= c.origin == "manual" ? "Requested manually" : "#{c.steps.size} steps" %></div>
          </td>
          <td class="px-3 py-2"><%= c.domain %></td>
          <td class="px-3 py-2 text-right"><%= c.occurrence_count %></td>
          <td class="px-3 py-2 text-right"><%= c.distinct_user_count %></td>
          <td class="px-3 py-2 whitespace-nowrap"><%= nice_datetime(c.last_seen_at) %></td>
          <td class="px-3 py-2"><%= status_badge(c.status) %></td>
        </tr>
      <% end %>
      <% if @candidates.empty? %>
        <tr><td colspan="6" class="px-3 py-6 text-center text-slate-500">Nothing here yet. Repeated workflows appear after the hourly sweep.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%== pagy_nav(@pagy) %></div>
