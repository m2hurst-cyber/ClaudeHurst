<% c = @candidate %>
<div class="flex flex-wrap justify-between items-start gap-2 mb-4">
  <div>
    <div class="text-xs text-slate-500 mb-1"><%= link_to "Skill review", skill_candidates_path, class: "hover:underline" %> / Candidate #<%= c.id %></div>
    <h1 class="text-2xl font-bold"><%= c.display_title %></h1>
    <div class="mt-1 flex gap-2 items-center text-sm"><%= status_badge(c.status) %> <span class="text-slate-500"><%= c.domain %> · <%= c.origin %></span></div>
  </div>
  <% if c.open? && policy(c).update? %>
    <div class="flex flex-wrap gap-2">
      <%= button_to (c.drafted? ? "Regenerate draft" : "Generate draft"), generate_draft_skill_candidate_path(c), class: "border px-3 py-1.5 rounded text-sm bg-white" %>
      <%= link_to "Edit draft", edit_skill_candidate_path(c), class: "border px-3 py-1.5 rounded text-sm bg-white" %>
      <% if policy(c).approve? && c.drafted? %>
        <%= button_to "Approve & publish", approve_skill_candidate_path(c), class: "bg-emerald-700 text-white px-3 py-1.5 rounded text-sm" %>
      <% end %>
    </div>
  <% end %>
  <% if c.skill %>
    <%= link_to "View published skill →", skill_path(c.skill), class: "text-sky-700 hover:underline text-sm" %>
  <% end %>
</div>

<div class="grid md:grid-cols-3 gap-4">
  <div class="md:col-span-2 space-y-4">
    <% if c.steps.any? %>
      <div class="bg-white border rounded p-4">
        <h2 class="font-semibold mb-2">Observed steps</h2>
        <ol class="list-decimal ml-5 space-y-1 text-sm">
          <% c.steps.each do |s| %>
            <li><%= SkillCapture::Catalog.describe(s) %> <code class="text-xs text-slate-500"><%= s %></code></li>
          <% end %>
        </ol>
      </div>
    <% end %>

    <div class="bg-white border rounded p-4">
      <div class="flex justify-between items-center mb-2">
        <h2 class="font-semibold">Draft skill</h2>
        <% if c.draft_generator %><span class="text-xs text-slate-500">by <%= c.draft_generator %> · <%= nice_datetime(c.drafted_at) %></span><% end %>
      </div>
      <% if c.drafted? %>
        <dl class="text-sm grid grid-cols-[8rem_1fr] gap-y-1 mb-3">
          <dt class="text-slate-500">Name</dt><dd class="font-mono"><%= c.draft_name %></dd>
          <dt class="text-slate-500">Description</dt><dd><%= c.draft_description %></dd>
          <dt class="text-slate-500">Tags</dt><dd><%= c.draft_tags.join(", ").presence || "—" %></dd>
          <dt class="text-slate-500">Inputs</dt><dd><%= Array(c.draft_inputs).join("; ").presence || "—" %></dd>
          <dt class="text-slate-500">Outputs</dt><dd><%= Array(c.draft_outputs).join("; ").presence || "—" %></dd>
        </dl>
        <pre class="whitespace-pre-wrap text-sm bg-slate-50 border rounded p-3 overflow-x-auto"><%= c.draft_body %></pre>
      <% else %>
        <p class="text-sm text-slate-500">No draft yet. Generate one, or write it yourself with “Edit draft”.</p>
      <% end %>
    </div>
  </div>

  <div class="space-y-4">
    <div class="bg-white border rounded p-4 text-sm space-y-1">
      <h2 class="font-semibold mb-1">Evidence</h2>
      <div>Seen <strong><%= c.occurrence_count %></strong> times by <strong><%= c.distinct_user_count %></strong> <%= "person".pluralize(c.distinct_user_count) %></div>
      <div>First seen: <%= nice_datetime(c.first_seen_at) %></div>
      <div>Last seen: <%= nice_datetime(c.last_seen_at) %></div>
      <div>Performed by: <%= c.contributors.map(&:display_name).join(", ").presence || "—" %></div>
      <% if c.requested_by %><div>Requested by: <%= c.requested_by.display_name %></div><% end %>
      <div>Reviewers: <%= c.reviewer_roles.join(", ") %></div>
      <% if c.example_traces.any? %>
        <details class="pt-2">
          <summary class="cursor-pointer text-slate-600">Example traces</summary>
          <% c.example_traces.each do |trace| %>
            <ul class="mt-2 text-xs font-mono text-slate-600 border-l pl-2">
              <% trace.each do |e| %><li><%= e["at"]&.first(16) %> <%= e["step"] %> <%= e["resource"] %></li><% end %>
            </ul>
          <% end %>
        </details>
      <% end %>
    </div>

    <% if c.reviewed_at %>
      <div class="bg-white border rounded p-4 text-sm">
        <h2 class="font-semibold mb-1">Review</h2>
        <div><%= c.status.humanize %> by <%= c.reviewer&.display_name %> on <%= nice_datetime(c.reviewed_at) %></div>
        <% if c.review_notes.present? %><p class="mt-1 text-slate-600"><%= c.review_notes %></p><% end %>
      </div>
    <% end %>

    <% if c.open? && policy(c).reject? %>
      <div class="bg-white border rounded p-4 text-sm space-y-2">
        <h2 class="font-semibold">Not a skill?</h2>
        <%= form_with url: reject_skill_candidate_path(c), method: :post, class: "space-y-2" do |f| %>
          <%= text_area_tag :review_notes, nil, rows: 2, placeholder: "Why (helps tune detection)", class: "border rounded px-2 py-1 w-full" %>
          <div class="flex gap-2">
            <%= f.submit "Reject", class: "bg-red-600 text-white px-3 py-1 rounded" %>
            <%= f.submit "Dismiss", formaction: dismiss_skill_candidate_path(c), class: "border px-3 py-1 rounded" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
