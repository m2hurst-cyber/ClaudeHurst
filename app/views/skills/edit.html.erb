<% s = @skill %>
<h1 class="text-2xl font-bold mb-1">Revise skill</h1>
<p class="text-sm text-slate-500 mb-4">Saving creates <strong>v<%= s.version + 1 %></strong> of <code><%= s.name %></code> and keeps v<%= s.version %> in history. Change the name to fork it into a separate skill instead.</p>

<%= form_with(model: s, class: "space-y-3 bg-white p-4 rounded shadow-sm border max-w-3xl") do |f| %>
  <div><%= f.label :name %><%= f.text_field :name, class: "border rounded px-2 py-1 w-full font-mono" %></div>
  <div><%= f.label :title %><%= f.text_field :title, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :description %><%= f.text_area :description, rows: 3, maxlength: 1024, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :tags, "Tags (comma separated)" %><%= f.text_field :tags, value: s.tags.join(", "), class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :body, "Instructions (Markdown)" %><%= f.text_area :body, rows: 18, class: "border rounded px-2 py-1 w-full font-mono text-sm" %></div>
  <div><%= label_tag "skill_change_note", "What changed and why" %><%= text_field_tag "skill[change_note]", nil, id: "skill_change_note", class: "border rounded px-2 py-1 w-full" %></div>
  <div class="flex gap-2">
    <%= f.submit "Save new version", class: "bg-slate-900 text-white px-3 py-1.5 rounded text-sm" %>
    <%= link_to "Cancel", skill_path(s), class: "border px-3 py-1.5 rounded text-sm" %>
  </div>
<% end %>
