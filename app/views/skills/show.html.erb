<% s = @skill %>
<div class="flex flex-wrap justify-between items-start gap-2 mb-4">
  <div>
    <div class="text-xs text-slate-500 mb-1"><%= link_to "Skill library", skills_path, class: "hover:underline" %></div>
    <h1 class="text-2xl font-bold"><%= s.title %></h1>
    <div class="font-mono text-xs text-slate-500"><%= s.name %> · v<%= s.version %> · <%= s.domain %> · <%= s.status %></div>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Download SKILL.md", download_skill_path(s), class: "border px-3 py-1.5 rounded text-sm bg-white" %>
    <% if policy(s).update? && s.status == "published" %>
      <%= link_to "Revise", edit_skill_path(s), class: "bg-slate-900 text-white px-3 py-1.5 rounded text-sm" %>
    <% end %>
    <% if policy(s).deprecate? && s.status == "published" %>
      <%= button_to "Deprecate", deprecate_skill_path(s), data: { turbo_confirm: "Deprecate this skill?" }, class: "border border-red-300 text-red-700 px-3 py-1.5 rounded text-sm bg-white" %>
    <% end %>
  </div>
</div>

<% if s.status != "published" %>
  <% current = Skill.published.where(name: s.name).order(version: :desc).first %>
  <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded p-3 text-sm mb-4">
    This version is <%= s.status %>.<% if current %> Current: <%= link_to "v#{current.version}", skill_path(current), class: "underline" %>.<% end %>
  </div>
<% end %>

<div class="grid md:grid-cols-3 gap-4">
  <div class="md:col-span-2 space-y-4">
    <div class="bg-white border rounded p-4">
      <p class="text-sm mb-3"><%= s.description %></p>
      <pre class="whitespace-pre-wrap text-sm bg-slate-50 border rounded p-3 overflow-x-auto"><%= s.body %></pre>
    </div>
  </div>
  <div class="space-y-4 text-sm">
    <div class="bg-white border rounded p-4 space-y-1">
      <h2 class="font-semibold mb-1">Origin</h2>
      <div>Published by <%= s.published_by&.display_name || "—" %> on <%= nice_datetime(s.published_at) %></div>
      <% if s.source["contributors"].present? %><div>Captured from work by: <%= Array(s.source["contributors"]).join(", ") %></div><% end %>
      <% if s.source["occurrences"] %><div>Observed <%= s.source["occurrences"] %>× before capture</div><% end %>
      <% if s.source["draft_generator"] %><div>Drafted by: <%= s.source["draft_generator"] %></div><% end %>
      <% if s.source_candidate %><div><%= link_to "Review record", skill_candidate_path(s.source_candidate), class: "text-sky-700 hover:underline" %></div><% end %>
      <% if s.source["change_note"] %><div>Change note: <%= s.source["change_note"] %></div><% end %>
      <div>License: <%= s.license %></div>
    </div>
    <div class="bg-white border rounded p-4">
      <h2 class="font-semibold mb-1">Versions</h2>
      <ul class="space-y-1">
        <% s.versions.each do |v| %>
          <li><%= link_to "v#{v.version}", skill_path(v), class: "text-sky-700 hover:underline #{'font-bold' if v == s}" %> · <%= v.status %> · <%= nice_date(v.published_at&.to_date) %></li>
        <% end %>
      </ul>
      <% lineage = s.lineage.drop(1) %>
      <% if lineage.any? { |l| l.name != s.name } %>
        <h3 class="font-semibold mt-3 mb-1">Forked from</h3>
        <% lineage.reject { |l| l.name == s.name }.first(1).each do |l| %>
          <%= link_to "#{l.name} v#{l.version}", skill_path(l), class: "text-sky-700 hover:underline" %>
        <% end %>
      <% end %>
      <% if s.children.any? { |ch| ch.name != s.name } %>
        <h3 class="font-semibold mt-3 mb-1">Forks</h3>
        <% s.children.reject { |ch| ch.name == s.name }.each do |ch| %>
          <div><%= link_to "#{ch.name} v#{ch.version}", skill_path(ch), class: "text-sky-700 hover:underline" %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
