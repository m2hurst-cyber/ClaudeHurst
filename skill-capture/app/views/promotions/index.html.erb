<% content_for :title, "Promotions" %>
<div class="mb-4">
  <h1 class="text-2xl font-bold">Promotions</h1>
  <p class="text-sm text-slate-500">Skills start in the sandbox (Local). Promotion to Firm makes them available to everyone and to agents; promotion to Market takes them beyond the firm. Each step passes its gates and an approver who didn't ask for it.</p>
</div>

<div class="flex flex-wrap items-center gap-2 text-sm mb-4">
  <%= stage_badge("local") %><span aria-hidden="true">→</span>
  <span class="text-xs text-slate-500">area reviewer</span><span aria-hidden="true">→</span>
  <%= stage_badge("firm") %><span aria-hidden="true">→</span>
  <span class="text-xs text-slate-500">admin</span><span aria-hidden="true">→</span>
  <%= stage_badge("market") %>
</div>

<h2 class="font-semibold mb-2">Waiting for a decision</h2>
<div class="space-y-3 mb-6">
  <% @open.each do |p| %>
    <% s = p.skill %>
    <% next unless s %>
    <% checks = Capture::Gates.for(s, p.to_stage) %>
    <% passed = Capture::Gates.passed?(checks) %>
    <% decider = Capture::Promotions.new(current_user).can_decide?(p) && p.requested_by_id != current_user.id %>
    <section id="promotion-<%= p.id %>" class="panel-soft p-4 text-sm">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <div>
          <%= link_to s.title, skill_path(s), class: "font-semibold text-base text-sky-700 hover:underline" %>
          <div class="mt-1 flex flex-wrap items-center gap-2"><%= stage_badge(p.from_stage) %><span aria-hidden="true">→</span><%= stage_badge(p.to_stage) %>
            <span class="text-xs text-slate-500">requested by <%= p.requested_by&.name %> · <%= nice_date(p.created_at) %></span></div>
          <% if p.replaces_name %><p class="mt-1">Replaces <strong><%= Skill.current(p.replaces_name)&.title || p.replaces_name %></strong> (retired when approved).</p><% end %>
          <% if p.pitch.present? %><p class="mt-1 text-slate-700">“<%= p.pitch %>”</p><% end %>
        </div>
        <span class="text-xs font-medium <%= passed ? 'text-slate-900' : 'text-slate-500' %>"><%= checks.count(&:passed) %>/<%= checks.size %> gates passed</span>
      </div>
      <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-1 mt-3">
        <% checks.each do |c| %>
          <li class="flex gap-2"><span aria-hidden="true" class="<%= c.passed ? 'text-[#0ca30c]' : 'text-[#d03b3b]' %>"><%= c.passed ? "✓" : "✗" %></span><span><%= c.label %> <span class="text-xs text-slate-500">· <%= c.detail %></span></span></li>
        <% end %>
      </ul>
      <div class="mt-3 flex flex-wrap gap-2 items-center">
        <% if decider %>
          <% if passed || current_user.admin? %>
            <%= form_with url: approve_promotion_path(p), method: :post, class: "flex flex-wrap gap-2 items-center" do |f| %>
              <%= text_field_tag :notes, nil, placeholder: (passed ? "Note (optional; required to decline)" : "Reason for waiving the failed gates"), class: "border rounded px-2 py-1 text-sm min-w-64", "aria-label": "Notes" %>
              <% unless passed %><label class="text-xs flex items-center gap-1"><%= check_box_tag :waive, "1" %> Waive failed gates (admin)</label><% end %>
              <%= f.submit "Approve", class: btn_primary %>
              <%= f.submit "Decline", formaction: reject_promotion_path(p), class: btn %>
            <% end %>
          <% else %>
            <%= form_with url: reject_promotion_path(p), method: :post, class: "flex flex-wrap gap-2 items-center" do |f| %>
              <span class="text-xs text-slate-700">Can't approve until every gate passes (only admins can waive).</span>
              <%= text_field_tag :notes, nil, placeholder: "What's missing? (required to decline)", class: "border rounded px-2 py-1 text-sm min-w-64", "aria-label": "Reason for declining" %>
              <%= f.submit "Decline", class: btn %>
            <% end %>
          <% end %>
        <% elsif p.requested_by_id == current_user.id %>
          <%= button_to "Withdraw", withdraw_promotion_path(p), method: :post, class: btn %>
          <span class="text-xs text-slate-500">Waiting for <%= p.to_stage == "market" ? "an admin" : "a reviewer for #{area_name(s.domain)}" %>.</span>
        <% else %>
          <span class="text-xs text-slate-500">Waiting for <%= p.to_stage == "market" ? "an admin" : "a reviewer for #{area_name(s.domain)}" %>.</span>
        <% end %>
      </div>
    </section>
  <% end %>
  <% if @open.empty? %><p class="panel-soft p-6 text-center text-sm text-slate-500">No open requests. Request a promotion from a skill's page, or from the Compare view.</p><% end %>
</div>

<h2 class="font-semibold mb-2">Recent decisions</h2>
<div class="panel-soft divide-y divide-sage-200 text-sm">
  <% @decided.each do |p| %>
    <div class="p-3 flex flex-wrap items-baseline gap-2">
      <span class="font-medium"><%= p.skill&.title || p.skill_name %></span>
      <%= stage_badge(p.to_stage) %>
      <span class="text-xs <%= p.status == 'approved' ? 'text-slate-900' : 'text-slate-500' %>"><%= p.status %><%= " (gates waived)" if p.waived %></span>
      <span class="text-xs text-slate-500">by <%= p.decided_by&.name %> · <%= nice_date(p.decided_at) %></span>
      <% if p.decision_notes.present? %><span class="text-xs text-slate-600 w-full">“<%= p.decision_notes %>”</span><% end %>
    </div>
  <% end %>
  <% if @decided.empty? %><p class="p-6 text-center text-slate-500">None yet.</p><% end %>
</div>
