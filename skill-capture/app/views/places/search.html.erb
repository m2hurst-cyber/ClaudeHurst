<% content_for :title, "Search the map" %>
<h1 class="text-2xl font-bold mb-3">Search the map</h1>
<%= form_with url: map_search_path, method: :get, class: "flex gap-2 mb-4" do |f| %>
  <%= search_field_tag :q, @q, placeholder: "Roads, intersections, handoffs, or words in their directions", class: "border rounded px-2 py-1.5 text-sm w-full sm:w-96", autofocus: true %>
  <%= f.submit "Search", class: btn %>
<% end %>
<div class="bg-white border rounded divide-y text-sm">
  <% @hits.each do |h| %>
    <%= link_to place_path(h.key), class: "flex items-baseline gap-3 p-3 hover:bg-slate-50" do %>
      <span class="w-24 shrink-0 text-xs text-slate-500"><%= Waypoint::KIND_LABELS[h.kind] %></span>
      <span class="flex-1"><span class="text-sky-700"><%= h.title %></span> <span class="text-xs text-slate-500"><%= h.subtitle %></span></span>
      <span class="text-xs <%= h.written ? 'text-slate-700' : 'text-slate-400' %>"><%= h.written ? "Written" : "Generated" %></span>
    <% end %>
  <% end %>
  <% if @q.present? && @hits.empty? %><p class="p-6 text-center text-slate-500">Nothing on the map matches “<%= @q %>”.</p><% end %>
</div>
