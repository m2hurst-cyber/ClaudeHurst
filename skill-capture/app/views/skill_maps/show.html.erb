<% content_for :title, "Skill map" %>
<%
  # Area colors: categorical slots in fixed order, assigned by sorted area name (never by rank),
  # so an area keeps its color whatever is filtered. Past 8 areas, the rest share "Other" gray.
  palette = %w[#2a78d6 #eb6834 #1baf7a #eda100 #e87ba4 #008300 #6250d6 #e34948]
  area_colors = @map[:areas].each_with_index.to_h { |a, i| [a, palette[i] || "#8a8985"] }
  skills = @map[:nodes].select { |n| n[:kind] == "skill" }.sort_by { |n| n[:title].downcase }
  nodes_by_id = @map[:nodes].index_by { |n| n[:id] }
%>
<%
  tier_colors = @schedule.sorted_tiers.to_h { |t| [t["key"], tier_status(t["key"])] }
%>
<div data-controller="route-map"
     data-route-map-route-url-value="<%= skill_map_route_path %>"
     data-route-map-search-url-value="<%= map_search_path(format: :json) %>"
     data-route-map-place-url-value="<%= place_path("KEY").delete_suffix("KEY") %>"
     data-route-map-colors-value="<%= area_colors.to_json %>"
     data-route-map-tiers-value="<%= tier_colors.transform_values { |v| v.slice(:color, :icon, :label) }.to_json %>"
     data-route-map-currency-value="<%= @schedule.currency %>">
  <script type="application/json" data-route-map-target="data"><%= raw json_escape(@map.to_json) %></script>

  <%= render "tabs", subtitle: "How skills connect end to end: roads people travel from one skill to the next, branches where a variant splits off, and roads not yet paved." %>

  <div class="relative mb-3">
    <label for="map-search" class="sr-only">Search roads and intersections</label>
    <input id="map-search" type="search" autocomplete="off" placeholder="Search roads, intersections and handoffs, or words in their directions…"
           class="border rounded px-3 py-2 text-sm w-full bg-white" data-route-map-target="search"
           data-action="input->route-map#searchInput keydown->route-map#searchKey" aria-controls="map-search-results">
    <div id="map-search-results" data-route-map-target="results" hidden
         class="absolute z-20 left-0 right-0 mt-1 bg-white border rounded shadow-sm max-h-80 overflow-auto text-sm" role="listbox"></div>
  </div>

  <form class="bg-white border rounded p-3 mb-3 flex flex-wrap items-end gap-2 text-sm" data-action="submit->route-map#plan">
    <label class="flex flex-col gap-1">From
      <select data-route-map-target="from" class="border rounded px-2 py-1.5 min-w-48">
        <option value="">Choose a skill</option>
        <% skills.each do |n| %><option value="<%= n[:id] %>"><%= n[:title] %></option><% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">To
      <select data-route-map-target="to" class="border rounded px-2 py-1.5 min-w-48">
        <option value="">Choose a skill</option>
        <% skills.each do |n| %><option value="<%= n[:id] %>"><%= n[:title] %></option><% end %>
      </select>
    </label>
    <button class="<%= btn_primary %>">Find route</button>
    <button type="button" class="<%= btn %>" data-action="route-map#clear">Clear</button>
    <div class="ml-auto flex gap-1" aria-label="Zoom">
      <button type="button" class="<%= btn %>" data-action="route-map#zoomOut" aria-label="Zoom out">−</button>
      <button type="button" class="<%= btn %>" data-action="route-map#fit">Fit</button>
      <button type="button" class="<%= btn %>" data-action="route-map#zoomIn" aria-label="Zoom in">+</button>
    </div>
  </form>

  <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
    <span class="text-slate-500">Color roads by</span>
    <div class="flex border rounded overflow-hidden" role="group" aria-label="Color roads by">
      <button type="button" class="px-2 py-1 bg-slate-900 text-white" data-route-map-target="modeBtn" data-mode="area" data-action="route-map#setMode" aria-pressed="true">Area</button>
      <button type="button" class="px-2 py-1 border-l bg-white" data-route-map-target="modeBtn" data-mode="traffic" data-action="route-map#setMode" aria-pressed="false">Traffic</button>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 mb-2" aria-label="Traffic legend" data-route-map-target="trafficLegend" hidden>
    <% tier_colors.each do |key, st| %>
      <span class="flex items-center gap-1.5"><span class="inline-block w-5 h-1.5 rounded-full" style="background: <%= st[:color] %>"></span><span style="color: <%= st[:color] %>" aria-hidden="true"><%= st[:icon] %></span><%= st[:label] %> <span class="text-slate-400">×<%= @schedule.tier(key)["multiplier"] %></span></span>
    <% end %>
    <span class="flex items-center gap-1.5"><span class="inline-block w-5 h-1.5 rounded-full bg-[#d6d3d1]"></span>Not enough traffic to price</span>
    <span class="flex items-center gap-1.5">💰 Open bounty</span>
  </div>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600 mb-2" aria-label="Legend" data-route-map-target="areaLegend">
    <% area_colors.each do |area, color| %>
      <button type="button" class="flex items-center gap-1.5 hover:text-slate-900" data-action="route-map#focusArea" data-area="<%= area %>" aria-pressed="false">
        <span class="inline-block w-5 h-1.5 rounded-full" style="background: <%= color %>"></span><%= area_name(area) %>
      </button>
    <% end %>
    <span class="flex items-center gap-1.5"><svg width="22" height="8" aria-hidden="true"><line x1="2" y1="4" x2="20" y2="4" stroke="#a8a29e" stroke-width="4" stroke-linecap="round" stroke-dasharray="5 4"/></svg>Unpaved (in review)</span>
    <span class="flex items-center gap-1.5"><svg width="22" height="10" aria-hidden="true"><line x1="2" y1="5" x2="20" y2="5" stroke="#b8b6b0" stroke-width="8" stroke-linecap="round"/></svg>Road between skills (thicker = more traffic)</span>
    <span class="flex items-center gap-1.5"><svg width="22" height="10" aria-hidden="true"><line x1="2" y1="5" x2="20" y2="5" stroke="#52514e" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 4"/></svg>Branch (variant)</span>
    <span class="flex items-center gap-1.5"><svg width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="#fff" stroke="#0b0b0b" stroke-width="2.5"/><circle cx="8" cy="8" r="2" fill="#0b0b0b"/></svg>Intersection (click for directions)</span>
  </div>

  <div class="grid lg:grid-cols-[1fr_20rem] gap-3">
    <div class="relative bg-[#f5f4f0] border rounded overflow-hidden h-[60vh] touch-none select-none" data-route-map-target="viewport"
         data-action="wheel->route-map#wheel pointerdown->route-map#panStart pointermove->route-map#panMove pointerup->route-map#panEnd pointerleave->route-map#panEnd">
      <svg data-route-map-target="svg" class="w-full h-full cursor-grab active:cursor-grabbing" role="img" aria-label="Route map of skills"></svg>
      <p class="absolute bottom-1 right-2 text-[11px] text-slate-500 pointer-events-none">Drag to move · scroll or +/− to zoom</p>
      <% if @map[:nodes].empty? %>
        <p class="absolute inset-0 grid place-items-center text-sm text-slate-500 p-6 text-center">No skills yet. Roads appear as workflows are published and people go from one skill to the next.</p>
      <% end %>
      <div data-route-map-target="tip" role="tooltip" hidden class="absolute z-10 pointer-events-none bg-white border rounded shadow-sm px-2 py-1.5 text-xs text-slate-900 max-w-64"></div>
    </div>
    <aside class="bg-white border rounded p-3 text-sm" data-route-map-target="panel" aria-live="polite">
      <h2 class="font-semibold mb-1">Plan a route</h2>
      <p class="text-slate-600">Pick where you are and where you need to get to, or click a skill on the map to see where people go next.</p>
    </aside>
  </div>

  <details class="mt-4 bg-white border rounded p-3 text-sm">
    <summary class="cursor-pointer text-slate-600">Show as list</summary>
    <ul class="mt-2 space-y-2">
      <% @map[:nodes].sort_by { |n| [n[:area].to_s, n[:title].downcase] }.each do |n| %>
        <% nexts = @map[:edges].select { |e| e[:from] == n[:id] && e[:kind] == "next" } %>
        <% branches = @map[:edges].select { |e| e[:from] == n[:id] && e[:kind] == "branch" } %>
        <li>
          <%= link_to n[:title], n[:url], class: "text-sky-700 hover:underline" %>
          <span class="text-slate-500">· <%= area_name(n[:area]) %><%= " · unpaved (in review)" if n[:kind] == "unpaved" %><%= " · improved ×#{n[:improvements]}" if n[:improvements].to_i.positive? %><%= " · #{@schedule.tier(n[:tier])&.dig('label')} traffic, #{credits(n[:price])} per trip" if n[:tier] %><%= " · bounty #{credits(n.dig(:bounty, :pool))}" if n[:bounty] %></span>
          <% if nexts.any? %><div class="text-slate-600">Next: <%= nexts.map { |e| "#{nodes_by_id[e[:to]][:title]} (#{e[:traffic]} trips#{', linked by a reviewer' if e[:manual]})" }.join("; ") %></div><% end %>
          <% if branches.any? %><div class="text-slate-600">Branches: <%= branches.map { |e| nodes_by_id[e[:to]][:title] }.join("; ") %></div><% end %>
        </li>
      <% end %>
    </ul>
  </details>
</div>
