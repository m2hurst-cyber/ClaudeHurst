<% content_for :title, "Formulas: #{FormulaCommand.provider_name(@provider)}" %>
<div class="flex flex-wrap items-end justify-between gap-3 mb-3">
  <div>
    <h1 class="text-2xl font-bold">Formula library</h1>
    <p class="text-sm text-slate-500">The small commands worksheet skills are built from. A skill names a command (for example <code>revenue</code>); the library holds the provider's exact formula. Commands start <strong>unverified</strong> until someone with access to the provider checks them.</p>
  </div>
  <div class="flex flex-wrap gap-2 items-center text-sm">
  <%= render "shared/llm_menu", url: formulas_path(provider: @provider, format: :md), filename: "#{@provider}-formulas" %>
  <%= link_to "Agent guide", guide_formulas_path(provider: @provider), class: "px-3 py-1.5 rounded border bg-white hover:bg-slate-50", title: "Observe → Interpret → Document → Write: how a worksheet becomes a skill" %>
  <%= link_to "Captured worksheets", worksheet_captures_path, class: "px-3 py-1.5 rounded border bg-white hover:bg-slate-50" %>
  <nav class="flex rounded border overflow-hidden text-sm" aria-label="Provider">
    <% @providers.each do |p| %>
      <%= link_to FormulaCommand.provider_name(p), formulas_path(provider: p), class: "px-3 py-1.5 #{p == @provider ? 'bg-slate-900 text-white' : 'bg-white hover:bg-slate-50'}" %>
    <% end %>
  </nav>
  </div>
</div>
<div class="grid lg:grid-cols-[14rem_1fr] gap-4">
  <aside class="space-y-4 text-sm">
    <div class="panel-soft p-3">
      <div class="font-semibold mb-1"><%= pluralize(@counts.values.sum, "command") %></div>
      <% FormulaCommand::STATUSES.each do |st| %>
        <%= link_to formulas_path(provider: @provider, status: (params[:status] == st ? nil : st)), class: "flex justify-between px-1 rounded #{'bg-slate-100' if params[:status] == st}" do %>
          <span><%= { "verified" => "✓ Verified", "unverified" => "◌ Unverified", "deprecated" => "⊘ Deprecated" }[st] %></span><span class="text-slate-500"><%= @counts[st].to_i %></span>
        <% end %>
      <% end %>
    </div>
    <div class="panel-soft p-3">
      <div class="font-semibold mb-1">Categories</div>
      <%= link_to "All", formulas_path(provider: @provider, q: params[:q]), class: "block px-1 rounded #{'bg-slate-100 font-medium' if params[:category].blank?}" %>
      <% @categories.each do |cat, n| %>
        <%= link_to formulas_path(provider: @provider, category: cat, q: params[:q]), class: "flex justify-between px-1 rounded #{'bg-slate-100 font-medium' if params[:category] == cat}" do %><span><%= cat %></span><span class="text-slate-500"><%= n %></span><% end %>
      <% end %>
    </div>
    <% if @can_manage %>
      <details class="panel-soft p-3">
        <summary class="font-semibold cursor-pointer">Add a command</summary>
        <%= form_with url: formulas_path(provider: @provider), scope: :formula_command, method: :post, class: "space-y-1.5 mt-2 text-xs" do |f| %>
          <%= f.text_field :key, placeholder: "key (e.g. ebit_margin)", class: input_css, required: true %>
          <%= f.text_field :name, placeholder: "Name", class: input_css, required: true %>
          <%= f.text_field :category, placeholder: "Category", class: input_css %>
          <%= f.text_area :syntax, rows: 2, placeholder: '=BQL({security},"field(fpt={fpt}, fpo={fpo})")', class: "#{input_css} font-mono", required: true %>
          <%= f.text_area :description, rows: 2, placeholder: "What it returns", class: input_css %>
          <button class="<%= btn_primary %> text-xs">Add</button>
        <% end %>
      </details>
      <details class="panel-soft p-3">
        <summary class="font-semibold cursor-pointer">Import a CSV</summary>
        <p class="text-xs text-slate-500 mt-1">Columns: key, name, category, syntax, description, defaults (<code>fpt=A; fpo=0</code>). Existing keys are updated; a changed formula goes back to unverified.</p>
        <%= form_with url: import_formulas_path(provider: @provider), method: :post, multipart: true, class: "mt-2 space-y-1.5 text-xs" do %>
          <input type="file" name="file" accept=".csv,text/csv" required class="text-xs">
          <button class="<%= btn %> text-xs">Import</button>
        <% end %>
      </details>
    <% end %>
  </aside>
  <div>
    <%= form_with url: formulas_path, method: :get, class: "flex gap-2 mb-3" do %>
      <%= hidden_field_tag :provider, @provider %><%= hidden_field_tag :category, params[:category] if params[:category].present? %>
      <input name="q" value="<%= params[:q] %>" placeholder="Search keys, names or formulas (e.g. ebitda, fpo, ESG)" class="<%= input_css %>" aria-label="Search formulas">
      <button class="<%= btn %>">Search</button>
    <% end %>
    <div class="panel-soft divide-y divide-sage-200 text-sm">
      <% if @commands.empty? %><p class="p-4 text-slate-500">No commands match.</p><% end %>
      <% @commands.each do |c| %>
        <% used = @usage[c.key] %>
        <div class="p-3" id="cmd-<%= c.id %>">
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="font-semibold"><%= c.name %></span>
            <code class="text-xs text-slate-500"><%= c.key %></code>
            <span class="text-xs text-slate-400"><%= c.category %></span>
            <span class="ml-auto text-xs px-1.5 rounded border <%= { 'verified' => 'bg-emerald-50 text-emerald-800 border-emerald-200', 'unverified' => 'bg-amber-50 text-amber-800 border-amber-200', 'deprecated' => 'bg-slate-100 text-slate-500' }[c.status] %>">
              <%= { "verified" => "✓ Verified", "unverified" => "◌ Unverified", "deprecated" => "⊘ Deprecated" }[c.status] %><%= " by #{c.verified_by.name}" if c.verified_by %></span>
          </div>
          <code class="block mt-1 text-xs bg-slate-50 border rounded px-2 py-1 break-all"><%= c.syntax %></code>
          <div class="text-xs text-slate-600 mt-1"><%= c.description %>
            <% if c.defaults.present? %><span class="text-slate-400"> · defaults: <%= c.defaults.map { |k, v| "#{k}=#{v.presence || '(set)'}" }.join(", ") %></span><% end %>
            <% if c.verification_note.present? %><span class="text-slate-500"> · note: <%= c.verification_note %></span><% end %>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-1 text-xs">
            <% if used.any? %><span class="text-slate-500">Used by <%= safe_join(used.map { |s| link_to(s.title.sub(/ \((BQL|FactSet)\)\z/, ""), skill_path(s), class: "text-sky-700 hover:underline") }, ", ") %></span><% else %><span class="text-slate-400">Not used by a skill yet</span><% end %>
            <% if @can_manage %>
              <span class="ml-auto flex gap-1">
                <% if c.status != "verified" %>
                  <%= form_with url: formula_path(c, provider: @provider), method: :patch, class: "flex gap-1" do %>
                    <%= hidden_field_tag :status, "verified" %><%= hidden_field_tag :q, params[:q] %><%= hidden_field_tag :category, params[:category] %>
                    <input name="note" placeholder="Checked how? (optional)" class="border rounded px-1 py-0.5 w-44">
                    <button class="px-1.5 rounded border bg-white hover:bg-emerald-50">✓ Verify</button>
                  <% end %>
                <% else %>
                  <%= button_to "Mark unverified", formula_path(c, provider: @provider), method: :patch, params: { status: "unverified" }, class: "px-1.5 rounded border bg-white", form: { class: "inline" } %>
                <% end %>
                <% unless c.status == "deprecated" %><%= button_to "Deprecate", formula_path(c, provider: @provider), method: :patch, params: { status: "deprecated" }, class: "px-1.5 rounded border bg-white text-slate-500", form: { class: "inline" } %><% end %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
