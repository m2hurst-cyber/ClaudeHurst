<% catalog = @playbook.catalog; spec = catalog[d.kind]; mine = @run.user_id == current_user.id %>
<% badge = { "uploaded" => ["Needs its figures", "bg-amber-50 text-amber-800 border-amber-200"], "reading" => ["AI reading…", "bg-sky-50 text-sky-800 border-sky-200"],
             "read" => ["Check and confirm", "bg-amber-50 text-amber-800 border-amber-200"], "confirmed" => ["✓ Confirmed", "bg-emerald-50 text-emerald-800 border-emerald-200"],
             "failed" => ["Couldn't read", "bg-red-50 text-red-800 border-red-200"] }[d.status] %>
<li id="doc-<%= d.id %>" class="border rounded p-2">
  <div class="flex items-start gap-2">
    <span class="inline-grid place-items-center w-9 h-6 rounded text-[10px] font-bold text-white <%= d.content_type == 'application/pdf' ? 'bg-red-700' : 'bg-slate-600' %>"><%= ReturnDocument::TYPES[d.content_type] %></span>
    <div class="flex-1 min-w-0">
      <div class="font-medium truncate"><%= d.label || d.filename %></div>
      <div class="text-xs text-slate-500 truncate"><%= [spec&.dig("name"), d.tax_year, d.payer].compact.join(" · ").presence || d.filename %></div>
    </div>
    <span class="text-[11px] px-1.5 py-0.5 rounded border whitespace-nowrap <%= badge[1] %>"><%= badge[0] %></span>
  </div>
  <% if d.read_by == "ai" && d.confidence %><div class="text-xs text-slate-500 mt-1">✨ Read by AI (<%= d.confidence %>% sure)<%= ": #{d.notes}" if d.notes.present? %></div>
  <% elsif d.notes.present? %><div class="text-xs text-slate-600 mt-1"><%= d.notes %></div><% end %>
  <% unless d.status == "reading" %>
    <details class="mt-1" <%= "open" if mine && %w[read uploaded failed].include?(d.status) && d == @documents.find { |x| %w[read uploaded failed].include?(x.status) } %>>
      <summary class="cursor-pointer text-xs text-sky-700"><%= d.status == "confirmed" ? "Figures" : "Check the figures against the document" %></summary>
      <%= form_with url: playbook_run_document_path(@run, d), method: :patch, class: "mt-2 space-y-1.5 text-xs" do %>
        <div class="grid grid-cols-2 gap-1.5">
          <label class="col-span-2">Kind
            <select name="kind" class="<%= input_css %> text-xs" <%= "disabled" unless mine %>>
              <option value="">Choose…</option>
              <% catalog.each do |k, v| %><option value="<%= k %>" <%= "selected" if d.kind.to_s == k.to_s %>><%= v["name"] %></option><% end %>
            </select></label>
          <label>Tax year<input name="tax_year" value="<%= d.tax_year %>" inputmode="numeric" class="<%= input_css %> text-xs" <%= "disabled" unless mine %>></label>
          <label>Issued by<input name="payer" value="<%= d.payer %>" class="<%= input_css %> text-xs" placeholder="business name" <%= "disabled" unless mine %>></label>
        </div>
        <% if spec %>
          <% vals = d.fields %>
          <% spec["fields"].each do |f| %>
            <label class="flex items-center gap-2"><span class="flex-1 text-slate-600"><%= f["label"] %></span>
              <% if f["type"] == "yes_no" %>
                <select name="fields[<%= f['key'] %>]" class="border rounded px-1 py-1 w-28" <%= "disabled" unless mine %>><option value=""></option><option value="yes" <%= "selected" if vals[f['key']] == 'yes' %>>Yes</option><option value="no" <%= "selected" if vals[f['key']] == 'no' %>>No</option></select>
              <% else %>
                <input name="fields[<%= f['key'] %>]" value="<%= vals[f['key']] %>" class="border rounded px-1 py-1 w-28 text-right tabular-nums" <%= 'inputmode="decimal"'.html_safe if %w[money number].include?(f['type']) %> <%= "disabled" unless mine %>>
              <% end %>
            </label>
          <% end %>
        <% end %>
        <% if mine %>
          <div class="flex gap-1 pt-1">
            <button name="confirm" value="1" class="<%= btn_primary %> text-xs">✓ Matches the document</button>
            <button class="<%= btn %> text-xs">Save</button>
          </div>
        <% end %>
      <% end %>
    </details>
  <% end %>
  <div class="flex gap-3 mt-1 text-xs">
    <%= link_to "View", playbook_run_document_path(@run, d), target: "_blank", rel: "noopener", class: "text-sky-700 hover:underline" %>
    <% if mine %>
      <% if Capture::DocumentReader.enabled? && d.status != "reading" %><%= button_to "Read again", read_playbook_run_document_path(@run, d), class: "text-sky-700 hover:underline", form: { class: "inline" } %><% end %>
      <%= button_to "Delete", playbook_run_document_path(@run, d), method: :delete, class: "text-slate-400 hover:text-red-700", form: { class: "inline" }, data: { turbo_confirm: "Delete this document?" } %>
    <% end %>
  </div>
</li>
