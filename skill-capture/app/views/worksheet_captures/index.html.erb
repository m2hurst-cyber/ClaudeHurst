<% content_for :title, "Captured worksheets" %>
<div class="mb-4">
  <h1 class="text-2xl font-bold">Captured worksheets</h1>
  <p class="text-sm text-slate-500">Sheets captured from Excel (Skill Capture tab › Capture sheet). Each one is observed, interpreted, documented and written up as a draft skill for the area's reviewers. Only labels and formulas are captured, never the numbers.</p>
</div>
<% if @captures.empty? %>
  <p class="text-sm text-slate-500 bg-white border rounded p-6 text-center">No captured worksheets yet. In Excel, open a BQL or FactSet sheet and choose <strong>Capture sheet</strong> on the Skill Capture tab.</p>
<% else %>
  <div class="bg-white border rounded overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs text-slate-500"><tr><th class="px-3 py-2">Sheet</th><th class="px-3 py-2">Provider</th><th class="px-3 py-2">Formulas</th><th class="px-3 py-2">Draft skill</th><th class="px-3 py-2">By</th><th class="px-3 py-2">When</th></tr></thead>
      <tbody>
        <% @captures.each do |c| %>
          <tr class="border-t">
            <td class="px-3 py-2"><%= link_to c.interpretation["title"].presence || c.sheet_name, worksheet_capture_path(c), class: "text-sky-700 hover:underline font-medium" %><div class="text-xs text-slate-500"><%= c.sheet_name %> · <%= c.interpretation["kind"] || "formulas only" %></div></td>
            <td class="px-3 py-2"><%= FormulaCommand.provider_name(c.provider) %></td>
            <td class="px-3 py-2"><%= c.inventory.size %></td>
            <td class="px-3 py-2"><% if c.candidate %><%= link_to c.candidate.draft_name, skill_candidate_path(c.candidate), class: "font-mono text-xs text-sky-700 hover:underline" %> <%= status_badge(c.candidate.status) %><% end %></td>
            <td class="px-3 py-2"><%= c.user.name %></td>
            <td class="px-3 py-2 text-xs text-slate-500"><%= time_ago_in_words(c.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
