<% content_for :title, "Connected Office apps" %>
<h1 class="text-2xl font-bold mb-1">Connected Office apps</h1>
<p class="text-sm text-slate-500 mb-4">Each place you signed in to the Skill Capture add-in. Disconnect any you no longer use.</p>
<div class="bg-white border rounded divide-y text-sm">
  <% @tokens.each do |t| %>
    <div class="p-3 flex items-center gap-3">
      <div class="flex-1">
        <div class="font-medium"><%= t.host.presence || "Office" %><%= " on #{t.platform}" if t.platform.present? %></div>
        <div class="text-xs text-slate-500">Connected <%= nice_time(t.created_at) %> · last used <%= nice_time(t.last_used_at) %></div>
      </div>
      <%= button_to "Disconnect", connected_app_path(t), method: :delete, class: btn %>
    </div>
  <% end %>
  <% if @tokens.empty? %><p class="p-6 text-center text-slate-500">No Office apps connected. Open <strong>Skills</strong> on the Home tab in Excel, Word or PowerPoint to connect.</p><% end %>
</div>
