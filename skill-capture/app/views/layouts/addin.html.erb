<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Skill Capture</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%# Office.js must be loaded from Microsoft's CDN, before any add-in code. %>
    <script src="https://appsforoffice.microsoft.com/lib/1/hosted/office.js"></script>
    <%= stylesheet_link_tag "tailwind" %>
    <%= javascript_importmap_tags(content_for(:entry).presence || "addin/blank") %>
  </head>
  <body class="bg-white text-slate-900 text-sm">
    <%= yield %>
  </body>
</html>
