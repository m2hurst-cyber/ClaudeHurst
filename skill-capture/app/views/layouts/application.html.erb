<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title).presence ? "#{content_for(:title)} · Skill Capture" : "Skill Capture" %></title>
    <link rel="icon" href="/addin/icon-32.png">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <% if user_signed_in? %>
      <header class="bg-slate-900">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-wrap items-center gap-1">
          <%= link_to "Skill Capture", root_path, class: "font-semibold text-white mr-3" %>
          <% mr = MacroReview.open.count %>
          <% nt = current_user.received_transfers.pending.count %>
          <% nr = current_user.reviewer? || current_user.admin? ? SkillCandidate.open.count : 0 %>
          <% npr = Promotion.open.count %>
          <nav class="flex flex-wrap items-center gap-0.5" aria-label="Sections">
            <%= nav_menu "Library", [
                  ["Skills", skills_path, "Every captured procedure, by level and area"],
                  ["Map", skill_map_path, "How the skills connect: roads, junctions, handoffs"],
                  ["Resources", resources_path, "Templates, contracts and workbooks skills call for"],
                  ["Formulas", formulas_path, "The provider and job costing command libraries"],
                  ["Macro library", library_macro_reviews_path, "Approved macros anyone can reuse"]] %>
            <%= nav_menu "Work", [
                  ["Playbooks", playbooks_path, "Curated workflows: start a job or a return"],
                  ["Flows", flows_path, "Process maps: sequence tasks across apps and agents"],
                  ["Prompts", prompts_path, "Save, extend or branch your repeated work", current_user.skill_prompts.live.count]] %>
            <%= nav_menu "Review", [
                  (["Skills waiting", skill_candidates_path, "Drafts waiting for an area reviewer", nr] if nr.positive? || current_user.reviewer? || current_user.admin?),
                  ["Macros", macro_reviews_path, "Tasks a script could do instead of the AI", mr, :quiet],
                  ["Promotions", promotions_path, "Skills moving from sandbox to firm to market", npr],
                  ["Transfers", transfers_path, "Skills sent to you, and what you sent", nt]] %>
            <%= nav_menu "Market", [
                  ["Bounties", bounties_path, "Congestion pricing and what a fix pays"],
                  ["Models", model_profiles_path, "Tiers, prices and what each kind of task runs on"]] %>
            <% if current_user.admin? %>
              <%= nav_menu "Admin", align: :right, items_list: [
                    ["People", admin_users_path, "Roles, areas and departments"],
                    ["Fields", admin_fields_path, "The field tree skills are classified into"],
                    ["Gates", admin_gates_path, "What a skill must pass to be promoted"],
                    ["Protocols", admin_protocols_path, "When to prompt someone to save, extend or branch"],
                    ["Pricing", admin_pricing_path, "The congestion schedule"],
                    ["Add-in", admin_deploy_path, "Manifest and deployment"],
                    ["Integrations", admin_sources_path, "Agents and collectors with API tokens"],
                    ["Actions", admin_action_definitions_path, "The vocabulary of recorded steps"],
                    ["Audit", admin_audit_logs_path, "Everything anyone changed"]] %>
            <% end %>
          </nav>
          <div class="ml-auto flex items-center gap-3 text-sm">
            <%= link_to "Help", help_path, class: "text-slate-300 hover:text-white", title: "Guides, FAQ and the walkthrough" %>
            <%= link_to notifications_path, class: "text-slate-300 hover:text-white" do %>
              Inbox<% if unread_notifications_count.positive? %> <span class="ml-1 bg-red-500 text-white rounded-full px-1.5 text-xs"><%= unread_notifications_count %></span><% end %>
            <% end %>
            <%= link_to current_user.name, connected_apps_path, class: "text-slate-400 hover:text-white hidden sm:inline", title: "Connected Office apps" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-slate-300 hover:text-white" %>
          </div>
        </div>
      </header>
      <% tour = Capture::Onboarding.for(current_user) %>
      <% if tour.nudge? && !request.path.start_with?("/start") %>
        <div class="bg-emerald-50 border-b border-emerald-200">
          <div class="max-w-6xl mx-auto px-4 py-2 flex flex-wrap items-center gap-3 text-sm">
            <span>
              <span class="font-medium">Getting started</span>
              — <%= tour.done_count %> of <%= tour.total %> done<%= ". Next: #{tour.next_step.title.downcase}" if tour.next_step %>.
            </span>
            <span class="ml-auto flex items-center gap-3">
              <%= link_to "Show me", tour_path, class: "underline font-medium" %>
              <%= button_to "Not now", dismiss_tour_path, class: "text-emerald-800/70 hover:text-emerald-900" %>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
    <main class="<%= content_for?(:wide) ? "max-w-[100rem]" : "max-w-6xl" %> mx-auto px-4 py-6">
      <% if notice %><div class="mb-4 rounded border border-emerald-200 bg-emerald-50 text-emerald-900 px-3 py-2 text-sm"><%= notice %></div><% end %>
      <% if alert %><div class="mb-4 rounded border border-red-200 bg-red-50 text-red-900 px-3 py-2 text-sm"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
