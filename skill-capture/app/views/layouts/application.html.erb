<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title).presence ? "#{content_for(:title)} · Skill Capture" : "Skill Capture" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <% if user_signed_in? %>
      <header class="bg-slate-900">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-wrap items-center gap-1">
          <%= link_to "Skill Capture", root_path, class: "font-semibold text-white mr-3" %>
          <%= nav_link "Library", skills_path %>
          <%= nav_link "Review", skill_candidates_path %>
          <% if current_user.admin? %>
            <%= nav_link "Sources", admin_sources_path %>
            <%= nav_link "Actions", admin_action_definitions_path %>
            <%= nav_link "People", admin_users_path %>
            <%= nav_link "Audit", admin_audit_logs_path %>
          <% end %>
          <div class="ml-auto flex items-center gap-3 text-sm">
            <%= link_to notifications_path, class: "text-slate-300 hover:text-white" do %>
              Inbox<% if unread_notifications_count.positive? %> <span class="ml-1 bg-red-500 text-white rounded-full px-1.5 text-xs"><%= unread_notifications_count %></span><% end %>
            <% end %>
            <span class="text-slate-400 hidden sm:inline"><%= current_user.name %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-slate-300 hover:text-white" %>
          </div>
        </div>
      </header>
    <% end %>
    <main class="max-w-6xl mx-auto px-4 py-6">
      <% if notice %><div class="mb-4 rounded border border-emerald-200 bg-emerald-50 text-emerald-900 px-3 py-2 text-sm"><%= notice %></div><% end %>
      <% if alert %><div class="mb-4 rounded border border-red-200 bg-red-50 text-red-900 px-3 py-2 text-sm"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
