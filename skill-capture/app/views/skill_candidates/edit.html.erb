<% c = @candidate %>
<% content_for :title, "Edit draft" %>
<h1 class="text-2xl font-bold mb-1">Edit draft</h1>
<p class="text-sm text-slate-500 mb-4"><%= link_to c.display_title, skill_candidate_path(c), class: "hover:underline" %></p>

<%= form_with(model: c, class: "space-y-3 bg-white p-4 rounded border max-w-3xl") do |f| %>
  <% if c.errors.any? %><div class="bg-red-50 border border-red-200 text-red-800 p-2 rounded text-sm"><%= c.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :draft_title, "Title" %><%= f.text_field :draft_title, class: input_css %></div>
  <div>
    <%= f.label :draft_name, "Skill name" %>
    <%= f.text_field :draft_name, class: input_css + " font-mono" %>
    <p class="text-xs text-slate-500">Lowercase letters, digits and hyphens; max 64. Reusing a published name publishes a new version of it.</p>
  </div>
  <div>
    <%= f.label :draft_description, "Description" %>
    <%= f.text_area :draft_description, rows: 3, maxlength: 1024, class: input_css %>
    <p class="text-xs text-slate-500">What it does and when to use it. People and agents pick skills from this text.</p>
  </div>
  <div><%= f.label :draft_tags, "Tags (comma separated)" %><%= f.text_field :draft_tags, value: c.draft_tags.join(", "), class: input_css %></div>
  <div class="grid md:grid-cols-2 gap-3">
    <div><%= f.label :draft_inputs, "Inputs (one per line)" %><%= f.text_area :draft_inputs, value: Array(c.draft_inputs).join("\n"), rows: 3, class: input_css %></div>
    <div><%= f.label :draft_outputs, "Outputs (one per line)" %><%= f.text_area :draft_outputs, value: Array(c.draft_outputs).join("\n"), rows: 3, class: input_css %></div>
  </div>

  <%# What it touches. The screen checks the body against this, so leaving it empty is a
      claim: that the skill stays inside the file in front of it. %>
  <fieldset class="panel-soft p-4 mt-4">
    <legend class="px-1 font-semibold text-sm">What this skill touches</legend>
    <p class="text-xs text-slate-500 mb-3">One per line. Leave a box empty to say the skill does not do that.
      The text is checked against what you declare here before it can be shared.</p>
    <div class="grid sm:grid-cols-2 gap-3 text-sm">
      <% caps = Capture::Capabilities.of(c) %>
      <% %w[reads writes sends tools hosts].each do |k| %>
        <div>
          <%= label_tag "skill_candidate_capabilities_#{k}", Capture::Capabilities::LABELS[k] %>
          <%= text_area_tag "skill_candidate[capabilities][#{k}]", Array(caps[k]).join("\n"),
                id: "skill_candidate_capabilities_#{k}", rows: 2, class: input_css,
                placeholder: { "reads" => "the open workbook", "writes" => "a new sheet", "sends" => "finance inbox",
                               "tools" => "a macro", "hosts" => "api.example.com" }[k] %>
        </div>
      <% end %>
      <label class="flex items-center gap-2 sm:col-span-2">
        <%= hidden_field_tag "skill_candidate[capabilities][needs_credentials]", "0", id: nil %>
        <%= check_box_tag "skill_candidate[capabilities][needs_credentials]", "1", caps["needs_credentials"] %>
        Needs someone to sign in or supply a key
      </label>
    </div>
  </div>
  <div><%= f.label :draft_body, "Instructions (Markdown)" %><%= f.text_area :draft_body, rows: 18, class: input_css + " font-mono text-sm" %></div>
  <div><%= f.label :review_notes, "Reviewer notes" %><%= f.text_area :review_notes, rows: 2, class: input_css %></div>
  <div class="flex gap-2">
    <%= f.submit "Save draft", class: btn_primary %>
    <%= link_to "Cancel", skill_candidate_path(c), class: btn %>
  </div>
<% end %>
