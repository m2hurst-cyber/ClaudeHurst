<% content_for :title, "Transfers" %>
<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
  <div>
    <h1 class="text-2xl font-bold">Transfers</h1>
    <p class="text-sm text-slate-500">Send a skill, or a selection, straight to a coworker: free, or for credits. Each transfer is an escrow contract: the skills are fingerprinted and held when offered, the credits are held when accepted, then both cross in one step, or the credits are refunded. Nothing moves up a level; the coworker gets the skills under <strong>Sent to me</strong>.</p>
  </div>
  <div class="flex items-center gap-3 text-sm">
    <span>Your credits <strong><%= credits(current_user.credits) %></strong></span>
    <%= link_to "Send skills", new_transfer_path, class: "px-3 py-1.5 rounded bg-slate-900 text-white" %>
  </div>
</div>

<% [["Received", @incoming, :sender, "From"], ["Sent", @outgoing, :recipient, "To"]].each do |heading, list, who, who_label| %>
  <section class="mb-5">
    <h2 class="font-semibold mb-2"><%= heading %></h2>
    <% if list.empty? %>
      <p class="text-sm text-slate-500 panel-soft p-4"><%= heading == "Received" ? "Nothing sent to you yet." : "You haven't sent anything yet." %></p>
    <% else %>
      <div class="panel-soft overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-xs text-slate-500"><tr><th class="px-3 py-2">Skills</th><th class="px-3 py-2"><%= who_label %></th><th class="px-3 py-2">Price</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">When</th><th class="px-3 py-2"></th></tr></thead>
          <tbody>
            <% list.each do |t| %>
              <tr class="border-t">
                <td class="px-3 py-2"><%= link_to t.label, transfer_path(t), class: "text-sky-700 hover:underline font-medium" %><% if t.items.size > 1 %><div class="text-xs text-slate-500"><%= t.items.map { |i| i["title"] }.first(3).join(", ") %><%= "…" if t.items.size > 3 %></div><% end %></td>
                <td class="px-3 py-2"><%= t.public_send(who).name %></td>
                <td class="px-3 py-2"><%= t.free? ? "Free" : credits(t.price) %></td>
                <td class="px-3 py-2"><%= render "transfers/status", t: t %></td>
                <td class="px-3 py-2 text-xs text-slate-500"><%= time_ago_in_words(t.created_at) %> ago</td>
                <td class="px-3 py-2 text-right whitespace-nowrap">
                  <% if t.pending? && who == :sender %>
                    <%= button_to (t.free? ? "Accept" : "Pay into escrow"), accept_transfer_path(t), class: "inline-block px-2 py-1 rounded bg-emerald-700 text-white text-xs", form_class: "inline" %>
                    <%= button_to "Decline", decline_transfer_path(t), class: "inline-block px-2 py-1 rounded border text-xs", form_class: "inline" %>
                  <% elsif t.pending? %>
                    <%= button_to "Withdraw", cancel_transfer_path(t), class: "inline-block px-2 py-1 rounded border text-xs", form_class: "inline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>

<% if @ledger.any? %>
  <section>
    <h2 class="font-semibold mb-2">Credits from transfers</h2>
    <ul class="panel-soft divide-y divide-sage-200 text-sm">
      <% @ledger.each do |e| %>
        <li class="px-3 py-2 flex justify-between gap-2"><span><%= e.reason %></span><span class="<%= e.amount.negative? ? 'text-red-700' : 'text-emerald-700' %> font-medium"><%= e.amount.positive? ? "+" : "" %><%= credits(e.amount) %></span></li>
      <% end %>
    </ul>
  </section>
<% end %>
