<% r = @run %>
<% content_for :title, "#{r.flow.name}: run" %>
<% content_for :wide, true %>
<% w, h, label, nw, nh = 214, 96, 110, 160, 70 %>
<% lanes = Flow::LANES & r.steps.map { |s| s["app"] } %>
<% width = label + [r.steps.size, 5].max * w %>
<% pos = r.steps.each_with_index.map { |s, i| [label + i * w + (w - nw) / 2, [lanes.index(s["app"]) || 0, 0].max * h + (h - nh) / 2] } %>
<% owner = r.owner?(current_user) %>
<% cur = r.current %>
<% t = r.tally %>
<% est_steps = t.dig("estimate", "steps") || [] %>
<div data-controller="run-refresh" data-run-refresh-url-value="<%= flow_run_path(r, format: :json) %>" data-run-refresh-stamp-value="<%= r.updated_at.to_f %>">
<div class="flex flex-wrap items-end justify-between gap-3 mb-3">
  <div>
    <div class="text-xs text-slate-500"><%= link_to "Flows", flows_path, class: "hover:underline" %> › <%= link_to r.flow.name, flow_path(r.flow), class: "hover:underline" if r.flow.visible_to?(current_user) %></div>
    <h1 class="text-2xl font-bold"><%= r.flow.name %></h1>
    <p class="text-sm text-slate-500">Started by <%= r.user.name %> <%= time_ago_in_words(r.created_at) %> ago · <%= r.done_count %> of <%= r.steps.size %> done</p>
  </div>
  <div class="flex gap-2 items-center">
  <%= render "shared/llm_menu", url: flow_run_path(r, format: :md), filename: "#{r.flow.name.parameterize}-run-#{r.id}" %>
  <% if owner && r.active? %>
    <div class="flex gap-2">
      <% if r.status == "on_hold" %><%= button_to "▶ Resume run", release_flow_run_path(r), class: "px-3 py-1.5 rounded bg-emerald-700 text-white text-sm" %>
      <% else %><%= button_to "⏸ Pause run", hold_flow_run_path(r), class: "px-3 py-1.5 rounded border bg-white text-sm", title: "Hold every handoff until you resume" %><% end %>
      <%= button_to "Stop", cancel_flow_run_path(r), class: "px-3 py-1.5 rounded border bg-white text-sm", form: { data: { turbo_confirm: "Stop this run?" } } %>
    </div>
  <% end %>
  </div>
</div>

<% if r.active? && cur %>
  <div class="mb-3 rounded border px-3 py-2 text-sm flex flex-wrap items-center gap-2 <%= r.status == 'on_hold' || cur['state'] == 'paused' ? 'border-amber-300 bg-amber-50' : 'border-sky-300 bg-sky-50' %>" role="status">
    <% if r.status == "on_hold" %>⏸ <strong>Run on hold</strong> at task <%= r.current_index + 1 %>, <%= cur["title"] %>. Nothing is handed off until it's resumed.
    <% elsif cur["state"] == "paused" %>⏸ <strong>Paused</strong> at step <%= r.current_index + 1 %>: <%= Flow.pause_label(cur) %><%= " (resumes #{Time.zone.parse(cur['resume_at']).to_fs(:short)})" if cur["resume_at"] %>.
    <% else %><span class="w-2.5 h-2.5 rounded-full bg-sky-600 animate-pulse" aria-hidden="true"></span> <strong>Running now: task <%= r.current_index + 1 %>, <%= cur["title"] %></strong> · <%= Flow.assignee_label(cur["assignee"], owner: r.user) %><%= " in #{cur['app']}" unless cur["app"] == "Agent" %><%= " · since #{time_ago_in_words(Time.zone.parse(cur['started_at']))}" if cur["started_at"] %>
    <% end %>
  </div>
<% elsif r.status == "completed" %>
  <div class="mb-3 rounded border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm" role="status">✓ Every task is done.</div>
<% end %>

<div class="bg-white border rounded overflow-auto mb-4" aria-label="Run map">
  <svg width="<%= width %>" height="<%= lanes.size * h %>" role="img" aria-label="<%= r.steps.each_with_index.map { |s, i| "#{i + 1}. #{s['title']}: #{s['state']}#{' (current)' if i == r.current_index && r.active?}" }.join('; ') %>">
    <defs><marker id="rarrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#64748b"/></marker></defs>
    <% lanes.each_with_index do |l, i| %>
      <rect x="0" y="<%= i * h %>" width="<%= width %>" height="<%= h %>" fill="<%= i.odd? ? '#f8fafc' : '#ffffff' %>"/>
      <text x="12" y="<%= i * h + h / 2 + 4 %>" font-size="12" fill="#64748b"><%= l %></text>
    <% end %>
    <% r.steps.each_cons(2).with_index do |(a, b), i| %>
      <% x1, y1 = pos[i][0] + nw, pos[i][1] + nh / 2 %><% x2, y2 = pos[i + 1][0], pos[i + 1][1] + nh / 2 %><% mx = (x1 + x2) / 2 %>
      <% crossing = !Flow.pause?(a) && !Flow.pause?(b) && (a["app"] != b["app"] || a["assignee"] != b["assignee"]) %>
      <path d="M<%= x1 %>,<%= y1 %> C<%= mx %>,<%= y1 %> <%= mx %>,<%= y2 %> <%= x2 - 6 %>,<%= y2 %>" fill="none" stroke-width="2" stroke="<%= a['state'] == 'done' ? '#047857' : (crossing ? '#0284c7' : '#94a3b8') %>" <%= 'stroke-dasharray="5,4"'.html_safe if crossing %> marker-end="url(#rarrow)"/>
    <% end %>
    <% r.steps.each_with_index do |s, i| %>
      <% x, y = pos[i] %>
      <% now = i == r.current_index && r.active? %>
      <% fill, stroke = { "done" => ["#ecfdf5", "#047857"], "ready" => ["#eff6ff", "#0284c7"], "paused" => ["#fffbeb", "#d97706"], "skipped" => ["#f8fafc", "#cbd5e1"], "pending" => [Flow.pause?(s) ? "#fffbeb" : "#ffffff", Flow.pause?(s) ? "#f59e0b" : "#cbd5e1"] }[s["state"]] || ["#fff", "#cbd5e1"] %>
      <g opacity="<%= s['state'] == 'skipped' ? 0.5 : 1 %>">
        <% if now %><rect x="<%= x - 5 %>" y="<%= y - 5 %>" width="<%= nw + 10 %>" height="<%= nh + 10 %>" rx="9" fill="none" stroke="<%= stroke %>" stroke-width="2" opacity="0.6"><animate attributeName="opacity" values="0.9;0.2;0.9" dur="1.6s" repeatCount="indefinite"/></rect><% end %>
        <rect x="<%= x %>" y="<%= y %>" width="<%= nw %>" height="<%= nh %>" rx="6" fill="<%= fill %>" stroke="<%= stroke %>" stroke-width="<%= now ? 3 : 1.5 %>" <%= 'stroke-dasharray="4,3"'.html_safe if Flow.pause?(s) %> />
        <text x="<%= x + 8 %>" y="<%= y + 18 %>" font-size="11" font-weight="600" fill="#0f172a"><%= "#{Flow.pause?(s) ? '⏸' : "#{i + 1}."} #{s['title'].truncate(24)}" %></text>
        <text x="<%= x + 8 %>" y="<%= y + 34 %>" font-size="10" fill="#475569"><%= (Flow.pause?(s) ? Flow.pause_label(s) : Flow.assignee_label(s["assignee"], owner: r.user)).truncate(26) %></text>
        <text x="<%= x + 8 %>" y="<%= y + 52 %>" font-size="10" font-weight="<%= now ? 700 : 400 %>" fill="<%= stroke %>"><%= now ? (r.status == "on_hold" ? "⏸ on hold" : (s["state"] == "paused" ? "⏸ waiting now" : "▶ running now")) : { "done" => "✓ done#{" · #{s.dig('usage', 'input_tokens').to_i + s.dig('usage', 'output_tokens').to_i} tok" if s['usage']}", "pending" => "waiting", "skipped" => "skipped" }[s["state"]] %><%= " · inserted" if s["inserted"] && !now %></text>
      </g>
    <% end %>
  </svg>
</div>

<section class="mb-4 bg-white border rounded p-3 text-sm" aria-label="Cost and time">
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
    <h2 class="font-semibold">Anticipated vs actual</h2>
    <span class="text-xs text-slate-500"><%= t.dig("estimate", "ai_steps") %> AI · <%= t.dig("estimate", "macro_steps") %> macro · models: <%= (t.dig("estimate", "models") || {}).map { |m, n| "#{Capture::Models.label(m)}×#{n}" }.join(", ") %></span>
  </div>
  <div class="grid sm:grid-cols-4 gap-3">
    <% spent = t["spent"]; est = t["estimate"]; proj = t["projected"] %>
    <% pct = est["tokens"].to_i.positive? ? [(spent["tokens"].to_f / est["tokens"] * 100).round, 100].min : 0 %>
    <div><div class="text-xs text-slate-500">Spent so far</div><div class="text-lg font-semibold"><%= number_with_delimiter(spent["tokens"]) %> <span class="text-xs font-normal text-slate-500">tokens</span></div><div class="text-xs"><%= number_to_currency(spent["cost"], unit: "", precision: 3) %> credits · <%= (spent["seconds"] / 60).round(1) %> min</div></div>
    <div><div class="text-xs text-slate-500">Anticipated, whole run</div><div class="text-lg font-semibold"><%= number_with_delimiter(est["tokens"]) %></div><div class="text-xs"><%= number_to_currency(est["cost"], unit: "", precision: 3) %> credits · ~<%= (est["seconds"].to_f / 60).round %> min</div></div>
    <div><div class="text-xs text-slate-500">Still to come</div><div class="text-lg font-semibold"><%= number_with_delimiter(t.dig("remaining", "tokens")) %></div><div class="text-xs"><%= number_to_currency(t.dig("remaining", "cost"), unit: "", precision: 3) %> credits</div></div>
    <div><div class="text-xs text-slate-500">Projected total</div><div class="text-lg font-semibold <%= proj["cost"] > est["cost"] * 1.15 ? "text-red-700" : "text-emerald-700" %>"><%= number_with_delimiter(proj["tokens"]) %></div><div class="text-xs"><%= number_to_currency(proj["cost"], unit: "", precision: 3) %> credits<%= " · #{((proj['cost'] / est['cost'] - 1) * 100).round}% vs plan" if est["cost"].to_f.positive? %></div></div>
  </div>
  <div class="mt-2 h-2 rounded bg-slate-100 overflow-hidden" role="img" aria-label="<%= pct %>% of the anticipated tokens spent"><div class="h-full bg-sky-600" style="width: <%= pct %>%"></div></div>
</section>

<div class="grid lg:grid-cols-[1fr_22rem] gap-4">
  <ol class="bg-white border rounded divide-y text-sm">
    <% r.steps.each_with_index do |s, i| %>
      <% now = i == r.current_index && r.active? %>
      <li class="p-3 <%= now ? 'bg-sky-50' : '' %> <%= 'opacity-60' if s['state'] == 'skipped' %>" id="step-<%= i %>">
        <div class="flex justify-between gap-2">
          <span class="font-medium"><%= Flow.pause?(s) ? "⏸" : "#{i + 1}." %> <%= s["title"] %><%= " ▶ now" if now %></span>
          <span class="text-xs text-slate-500"><%= Flow.pause?(s) ? Flow.pause_label(s) : "#{s['app']} · #{Flow.assignee_label(s['assignee'], owner: r.user)}" %> · <%= now && r.status == "on_hold" ? "on hold" : s["state"] %></span>
        </div>
        <% e = est_steps[i] || {} %>
        <% unless Flow.pause?(s) %>
          <div class="text-xs text-slate-500"><%= Capture::TaskProfile.label(s["nature"] || e["nature"]) %> · <%= s["complexity"] || e["complexity"] %> ·
            <%= e["engine"] == "macro" || s["engine"] == "macro" ? "⚙ macro, no tokens" : "#{Capture::Models.label(s['model'] || e['model'])}, about #{number_with_delimiter(e['tokens'])} tokens (#{number_to_currency(e['cost'], unit: '', precision: 3)} cr)" %>
            <% if (u = s["usage"]) %> → actual <strong><%= number_with_delimiter(u["input_tokens"].to_i + u["output_tokens"].to_i) %></strong> tokens<%= " (#{number_to_currency(u['cost'], unit: '', precision: 3)} cr)" if u["cost"] %><% end %>
          </div>
        <% end %>
        <% if Flow.split?(s) %>
          <ul class="mt-1 space-y-1">
            <% Flow.parts(s).each do |p| %>
              <li class="border rounded px-2 py-1 text-xs <%= p['state'] == 'done' ? 'bg-emerald-50 border-emerald-300' : 'bg-white' %>">
                <div class="flex flex-wrap justify-between gap-2">
                  <span><%= Flow.engine_label(p["engine"]) %> <strong><%= p["title"] %></strong> · <%= Flow.assignee_label(p["assignee"], owner: r.user) %><%= " · #{Capture::Models.label(p['model'])}" if p["model"] && p["engine"] == "ai" %></span>
                  <span><%= p["state"] == "done" ? "✓ #{p['by']}" : (i == r.current_index && r.running? ? "running" : "waiting") %></span>
                </div>
                <% if p["note"] %><div class="text-slate-600"><%= p["note"] %></div><% end %>
                <% if i == r.current_index && r.running? && p["state"] != "done" && r.assigned?(p["assignee"], user: current_user) %>
                  <%= form_with url: complete_part_flow_run_path(r, step: i, part: p["id"]), method: :post, class: "flex gap-1 mt-1" do %>
                    <input name="note" placeholder="What you did" class="flex-1 border rounded px-1 py-0.5">
                    <button class="px-2 py-0.5 rounded bg-emerald-700 text-white">My part is done</button>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if s["skill_name"] && (sk = Skill.current(s["skill_name"])) %><div class="text-xs">📘 <%= link_to sk.title, skill_path(sk), class: "text-sky-700 hover:underline" %></div><% end %>
        <% if s["instructions"] %><p class="text-slate-600 text-xs mt-0.5"><%= s["instructions"] %></p><% end %>
        <% if s["state"] == "done" %>
          <p class="text-xs text-emerald-800 mt-1">✓ <%= s["by"] %><%= " · #{Time.zone.parse(s['finished_at']).to_fs(:short)}" if s["finished_at"] %><%= ": #{s['note']}" if s["note"] %></p>
          <% if (u = s["usage"]) %><p class="text-xs text-slate-500"><%= u["model"] %> · <%= number_with_delimiter(u["input_tokens"].to_i) %> in / <%= number_with_delimiter(u["output_tokens"].to_i) %> out<%= " · #{(u['duration_ms'].to_i / 1000.0).round(1)} s" if u["duration_ms"] %></p><% end %>
        <% end %>
        <% if owner && r.active? %>
          <div class="flex flex-wrap gap-1 mt-1.5 text-xs">
            <% unless now %><%= button_to "Deploy now", jump_flow_run_path(r, step: i), class: "px-2 py-0.5 rounded border bg-white hover:bg-slate-50", title: i > r.current_index ? "Make this the current task; the ones before it are skipped" : "Run again from here", form_class: "inline" unless Flow.pause?(s) %><% end %>
            <% if %w[pending ready paused].include?(s["state"]) %><%= button_to "Skip", skip_flow_run_path(r, step: i), class: "px-2 py-0.5 rounded border bg-white hover:bg-slate-50", form_class: "inline" %><% end %>
            <% if now && s["state"] == "paused" %><%= button_to "▶ Resume", resume_flow_run_path(r, step: i), class: "px-2 py-0.5 rounded bg-amber-600 text-white", form_class: "inline" %><% end %>
            <% if i >= r.current_index %>
              <details class="inline-block"><summary class="cursor-pointer px-2 py-0.5 rounded border bg-white list-none">＋ Insert after</summary>
                <%= form_with url: insert_flow_run_path(r, after: i), method: :post, class: "mt-1 p-2 border rounded bg-white space-y-1 w-72" do %>
                  <select name="kind" class="w-full border rounded px-1 py-0.5" aria-label="Kind"><option value="task">Task</option><option value="pause">Pause</option></select>
                  <input name="title" placeholder="Title (for a task)" class="w-full border rounded px-1 py-0.5" aria-label="Title">
                  <div class="flex gap-1"><select name="app" class="flex-1 border rounded px-1 py-0.5" aria-label="Lane"><% Flow::LANES.each do |l| %><option><%= l %></option><% end %></select>
                    <select name="pause_mode" class="flex-1 border rounded px-1 py-0.5" aria-label="Pause until"><option value="manual">Pause: until resumed</option><option value="timer">Pause: minutes</option></select></div>
                  <input name="pause_minutes" type="number" min="1" placeholder="Minutes (timed pause)" class="w-full border rounded px-1 py-0.5" aria-label="Minutes">
                  <button class="w-full px-2 py-1 rounded bg-slate-900 text-white">Insert</button>
                <% end %>
              </details>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ol>
  <aside class="bg-white border rounded p-4 text-sm self-start">
    <% if r.running? && Flow.split?(cur.to_h) && r.doer?(user: current_user) %>
      <h2 class="font-semibold mb-1">Your part of task <%= r.current_index + 1 %></h2>
      <p class="text-slate-600 mb-2">This task is split: <%= Flow.parts(cur).map { |p| "#{Flow.engine_label(p['engine'])} #{p['title']}" }.join(" · ") %>. Finish yours in the list; the task hands off when every part is done.</p>
    <% elsif r.running? && r.doer?(user: current_user) %>
      <h2 class="font-semibold mb-1">Your turn: task <%= r.current_index + 1 %></h2>
      <p class="text-slate-600 mb-2"><%= cur["title"] %><%= " (in #{cur['app']})" unless cur["app"] == "Agent" %><%= ". Standing in for the agent." if cur["assignee"].to_s.start_with?("agent:") %></p>
      <%= form_with url: complete_flow_run_path(r, step: r.current_index), method: :post do %>
        <label class="block">What you did, or where the output is<textarea name="note" rows="3" class="mt-1 w-full border rounded px-2 py-1"></textarea></label>
        <% nxt = (r.current_index + 1...r.steps.size).find { |k| r.steps[k]["state"] == "pending" } %>
        <button class="mt-2 w-full px-3 py-2 rounded bg-emerald-700 text-white">Done: hand off to <%= nxt ? (Flow.pause?(r.steps[nxt]) ? "the pause" : "task #{nxt + 1}") : "finish" %></button>
      <% end %>
    <% elsif r.active? && cur && cur["state"] == "paused" %>
      <p>Paused: <%= Flow.pause_label(cur) %>.<%= " Resumes #{Time.zone.parse(cur['resume_at']).to_fs(:short)}." if cur["resume_at"] %></p>
      <% if owner %><%= button_to "▶ Resume now", resume_flow_run_path(r, step: r.current_index), class: "mt-2 w-full px-3 py-2 rounded bg-amber-600 text-white" %><% end %>
    <% elsif r.active? %>
      <p><%= r.status == "on_hold" ? "On hold." : "Waiting on" %> <strong><%= Flow.assignee_label(cur["assignee"], owner: r.user) unless r.status == "on_hold" %></strong><%= " for task #{r.current_index + 1}. They were sent it#{" in #{cur['app']}" unless cur['app'] == 'Agent'}." unless r.status == "on_hold" %></p>
    <% else %>
      <p><%= r.status == "completed" ? "✓ Every task is done." : "Stopped." %></p>
    <% end %>
    <% if owner && r.active? %><p class="text-xs text-slate-500 mt-3"><strong>Deploy now</strong> makes any task current (skipping the ones before it, or re-running from there); <strong>Insert after</strong> adds a task or a pause into this run.</p><% end %>
    <% tok = r.steps.sum { |s| s.dig("usage", "input_tokens").to_i + s.dig("usage", "output_tokens").to_i } %>
    <% if tok.positive? %><p class="text-xs text-slate-500 mt-3">AI usage so far: <%= number_with_delimiter(tok) %> tokens across <%= pluralize(r.steps.count { |s| s['usage'] }, 'task') %>.</p><% end %>
  </aside>
</div>
</div>
