<% content_for :title, @flow.name %>
<% content_for :wide, true %>
<% assignees = [{ value: "me", label: "Me (whoever runs it)" }] + @people.map { |u| { value: "user:#{u.id}", label: u.name } } + @agents.map { |a| { value: "agent:#{a.id}", label: "🤖 #{a.name}" } } %>
<div data-controller="flow-map" data-flow-map-steps-value="<%= @flow.steps.to_json %>" data-flow-map-url-value="<%= flow_path(@flow) %>"
     data-flow-map-assignees-value="<%= assignees.to_json %>" data-flow-map-skills-value="<%= @palette.map { |s| { name: s.name, title: s.title } }.to_json %>"
     data-flow-map-run-url-value="<%= run_flow_path(@flow) %>"
     data-flow-map-estimate-value="<%= @estimate.to_json %>"
     data-flow-map-natures-value="<%= Capture::TaskProfile::NATURES.map { |k, v| { value: k, label: v[:label], tier: v[:tier], about: v[:about] } }.to_json %>"
     data-flow-map-models-value="<%= Capture::Models.catalogue.map { |m| { key: m.key, name: m.name, tier: m.tier } }.to_json %>"
     data-flow-map-macros-value="<%= @macros.transform_values { |r| { id: r.id, status: r.status, verdict: r.verdict, url: macro_review_path(r) } }.to_json %>"
     data-flow-map-run-value="<%= (@live ? { id: @live.id, json_url: flow_run_path(@live, format: :json), status: @live.status, current_index: @live.current_index,
                                            ids: @live.steps.map { |s| s["id"] }, states: @live.steps.map { |s| s["state"] }, titles: @live.steps.map { |s| s["title"] } } : {}).to_json %>">
  <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
    <div class="flex-1 min-w-64">
      <div class="text-xs text-slate-500"><%= link_to "Flows", flows_path, class: "hover:underline" %> ›</div>
      <input data-flow-map-target="name" data-action="input->flow-map#rename" value="<%= @flow.name %>" aria-label="Flow name" class="text-2xl font-bold bg-transparent border-b border-transparent hover:border-slate-300 focus:border-slate-500 outline-none w-full">
      <p class="text-sm text-slate-500">Lanes are where the work happens; tasks run left to right. A dashed arrow is a <span class="text-sky-700">handoff</span> to another app, person or agent.</p>
    </div>
    <div class="flex items-center gap-2 text-sm">
      <span data-flow-map-target="estimate" class="text-xs text-slate-600"></span>
      <span data-flow-map-target="status" class="text-xs text-slate-500"></span>
      <%= render "shared/llm_menu", url: flow_path(@flow, format: :md), filename: @flow.name.parameterize %>
      <button type="button" data-action="flow-map#save" class="px-3 py-1.5 rounded border bg-white">Save</button>
      <%= button_to "▶ Run", run_flow_path(@flow), class: "px-3 py-1.5 rounded bg-emerald-700 text-white", form: { data: { action: "submit->flow-map#beforeRun" } } %>
    </div>
  </div>
  <div data-flow-map-target="live" hidden class="mb-2 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm flex flex-wrap items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span><strong data-live-text></strong>
    <% if @live %><%= link_to "Open the run", flow_run_path(@live), class: "text-sky-700 hover:underline ml-auto" %><% end %>
  </div>
  <div class="grid lg:grid-cols-[15rem_1fr_17rem] gap-3">
    <aside class="panel-soft p-3 text-sm self-start">
      <h2 class="font-semibold mb-1">Palette</h2>
      <p class="text-xs text-slate-500 mb-2">Drag onto a lane, or click to add at the end.</p>
      <% blank = { title: "New task" } %>
      <button type="button" draggable="true" data-flow-map-target="paletteItem" data-text="blank task" data-item="<%= blank.to_json %>" data-action="dragstart->flow-map#dragPalette click->flow-map#addFromPalette"
              class="w-full text-left px-2 py-1.5 mb-1 rounded border border-dashed border-slate-400 cursor-grab hover:bg-slate-50">＋ Blank task</button>
      <% pause = { kind: "pause", title: "Pause" } %>
      <button type="button" draggable="true" data-flow-map-target="paletteItem" data-text="pause wait" data-item="<%= pause.to_json %>" data-action="dragstart->flow-map#dragPalette click->flow-map#addFromPalette"
              class="w-full text-left px-2 py-1.5 mb-2 rounded border border-dashed border-amber-500 bg-amber-50 cursor-grab hover:bg-amber-100">⏸ Pause <span class="text-xs text-slate-500">(wait to resume, or a set time)</span></button>
      <input type="search" data-flow-map-target="filter" data-action="input->flow-map#filter" placeholder="Filter skills" class="w-full border rounded px-2 py-1 mb-2" aria-label="Filter skills">
      <ul class="max-h-[30rem] overflow-y-auto space-y-1">
        <% @palette.each do |s| %>
          <% apps = @classes[s.name]&.apps || [] %>
          <li><button type="button" draggable="true" data-flow-map-target="paletteItem" data-text="<%= [s.title, s.name, apps.join(' ')].join(' ').downcase %>"
                      data-item="<%= { name: s.name, title: s.title, apps: apps }.to_json %>" data-action="dragstart->flow-map#dragPalette click->flow-map#addFromPalette"
                      class="w-full text-left px-2 py-1 rounded border cursor-grab hover:bg-slate-50 text-xs"><span class="font-medium"><%= s.title %></span><span class="block text-slate-500"><%= apps.join(", ").presence || area_name(s.domain) %></span></button></li>
        <% end %>
      </ul>
    </aside>
    <div class="panel-soft overflow-auto relative" data-flow-map-target="canvas" data-action="dragover->flow-map#over dragleave->flow-map#leave drop->flow-map#drop" aria-label="Process map">
      <div class="relative" data-flow-map-target="nodes">
        <svg data-flow-map-target="svg" class="absolute inset-0" aria-hidden="true"></svg>
        <div data-flow-map-target="marker" class="absolute w-1 rounded bg-sky-600" style="display:none"></div>
      </div>
    </div>
    <aside class="panel-soft p-3 text-sm self-start" data-flow-map-target="editor"></aside>
  </div>
  <% if @runs.any? %>
    <section class="mt-4 text-sm"><h2 class="font-semibold mb-1">Runs</h2>
      <% @runs.each do |r| %><div><%= link_to "#{time_ago_in_words(r.created_at)} ago", flow_run_path(r), class: "text-sky-700 hover:underline" %> · <%= r.status == "running" ? "task #{r.current_index + 1} of #{r.steps.size}" : r.status %></div><% end %>
    </section>
  <% end %>
</div>
