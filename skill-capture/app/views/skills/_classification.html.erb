<%# Fields + apps for a skill card. locals: c (SkillClassification or nil), compact, show_source %>
<% compact = local_assigns.fetch(:compact, false) %>
<% show_source = local_assigns.fetch(:show_source, true) %>
<% fields = c ? c.ordered_fields : [] %>
<div class="flex flex-col gap-1 <%= 'text-xs' if compact %>">
  <div class="flex flex-wrap items-center gap-1">
    <span class="text-xs text-slate-500 mr-1"><%= fields.size > 1 ? "Fields" : "Field" %></span>
    <% if fields.any? %>
      <% fields.each do |f| %>
        <%= link_to f.label, skills_path(field: f.path), class: "text-xs font-medium text-slate-900 bg-slate-100 hover:bg-slate-200 rounded px-1.5 py-0.5", title: "All skills in #{f.label}" %>
      <% end %>
    <% else %>
      <span class="text-xs text-slate-400">Not classified</span>
    <% end %>
    <% if c&.bridge? %><span class="text-xs text-slate-800 border border-slate-500 rounded px-1" title="This skill carries work across apps or fields">⇄ Bridge: <%= c.bridge_label(Skill.current(c.skill_name)) %></span><% end %>
    <%= classification_source(c) if show_source %>
  </div>
  <div class="flex flex-wrap items-center gap-1">
    <span class="text-xs text-slate-500 mr-1">Apps</span>
    <% if c && c.apps.any? %><% c.apps.each { |a| %><%= app_chip(a) %><% } %><% else %><span class="text-xs text-slate-400">—</span><% end %>
  </div>
</div>
