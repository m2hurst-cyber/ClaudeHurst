<%# Field + apps for a skill card. locals: c (SkillClassification or nil), compact (bool) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% show_source = local_assigns.fetch(:show_source, true) %>
<div class="flex flex-col gap-1 <%= 'text-xs' if compact %>">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="text-xs text-slate-500">Field</span>
    <% if c&.field %>
      <span class="text-xs font-medium text-slate-900"><%= c.field.label %></span>
    <% else %>
      <span class="text-xs text-slate-400">Not classified</span>
    <% end %>
    <%= classification_source(c) if show_source %>
  </div>
  <div class="flex flex-wrap items-center gap-1">
    <span class="text-xs text-slate-500 mr-1">Apps</span>
    <% if c && c.apps.any? %><% c.apps.each { |a| %><%= app_chip(a) %><% } %><% else %><span class="text-xs text-slate-400">—</span><% end %>
  </div>
</div>
