<% u = Capture::Intensity.for(s.name) %>
<div class="panel-soft p-4 text-sm" id="agent-usage">
  <div class="flex items-center justify-between gap-2 mb-1">
    <h2 class="font-semibold">AI agent usage</h2>
    <% if (mr = MacroReview.for_subject("skill", s.name)) && mr.approved? %><span class="px-1.5 py-0.5 rounded text-xs bg-emerald-100 text-emerald-900" title="An approved macro does this without the AI">⚙ Macro</span><% end %>
  <% if u&.dig(:intensity) %><span class="px-1.5 py-0.5 rounded text-xs <%= { "light" => "bg-emerald-100 text-emerald-900", "moderate" => "bg-amber-100 text-amber-900", "heavy" => "bg-red-100 text-red-800" }[u[:intensity]] %>"><%= u[:intensity].capitalize %> intensity</span><% end %>
  </div>
  <% if u %>
    <dl class="grid grid-cols-2 gap-x-3 gap-y-1">
      <dt class="text-slate-500">Runs (90 days)</dt><dd><%= number_with_delimiter(u[:runs]) %><%= " · #{(u[:success_rate] * 100).round}% succeeded" if u[:success_rate] %></dd>
      <dt class="text-slate-500">Tokens per run</dt><dd><%= number_with_delimiter(u[:avg_tokens]) %> <span class="text-xs text-slate-500">(<%= number_with_delimiter(u[:avg_input_tokens]) %> in · <%= number_with_delimiter(u[:avg_output_tokens]) %> out)</span></dd>
      <dt class="text-slate-500">Time per run</dt><dd><%= u[:avg_seconds] ? "#{u[:avg_seconds]} s" : "—" %></dd>
      <dt class="text-slate-500">Tokens per minute</dt><dd><%= u[:tokens_per_minute] ? number_with_delimiter(u[:tokens_per_minute]) : "—" %></dd>
    </dl>
    <table class="w-full text-xs mt-2">
      <thead class="text-slate-500 text-left"><tr><th class="py-1">Model</th><th>Runs</th><th>Tokens/run</th><th>Time</th></tr></thead>
      <tbody><% u[:models].each do |m| %><tr class="border-t"><td class="py-1 font-mono break-all"><%= m[:model] %></td><td><%= m[:runs] %></td><td><%= number_with_delimiter(m[:avg_tokens]) %></td><td><%= m[:avg_seconds] ? "#{m[:avg_seconds]} s" : "—" %></td></tr><% end %></tbody>
    </table>
    <p class="text-xs text-slate-500 mt-1">Last run <%= time_ago_in_words(Time.zone.parse(u[:last_run_at])) %> ago.</p>
    <% plan = Capture::Estimator.trial_plan({ "title" => s.title, "instructions" => s.description, "skill_name" => s.name }) %>
    <h3 class="font-medium text-xs text-slate-500 mt-3 mb-1">What a run costs on each model</h3>
    <table class="w-full text-xs">
      <thead class="text-slate-500 text-left"><tr><th class="py-1">Model</th><th>Tokens</th><th>Credits</th><th>Time</th></tr></thead>
      <tbody><% plan.each do |m| %><tr class="border-t"><td class="py-1"><%= m["name"] %> <span class="text-slate-400"><%= m["tier"] %></span></td><td><%= number_with_delimiter(m["tokens"]) %></td><td><%= number_to_currency(m["cost"], unit: "", precision: 3) %></td><td><%= m["seconds"] %> s</td></tr><% end %></tbody>
    </table>
    <% trials = SkillRun.where(skill_name: s.name).where.not(trial_of: nil).distinct.pluck(:trial_of) %>
    <% trials.first(3).each do |tid| %>
      <h3 class="font-medium text-xs text-slate-500 mt-3 mb-1">Tried on several models · <code><%= tid %></code></h3>
      <table class="w-full text-xs">
        <thead class="text-slate-500 text-left"><tr><th class="py-1">Model</th><th>Runs</th><th>Tokens</th><th>Credits</th><th>Time</th><th>Succeeded</th></tr></thead>
        <tbody><% Capture::Estimator.trial_results(tid).each_with_index do |t, i| %>
          <tr class="border-t <%= 'bg-emerald-50' if i.zero? %>"><td class="py-1 font-mono"><%= t["model"] %></td><td><%= t["runs"] %></td><td><%= number_with_delimiter(t["input_tokens"] + t["output_tokens"]) %></td><td><%= number_to_currency(t["cost"], unit: "", precision: 3) %></td><td><%= t["seconds"] || "—" %></td><td><%= t["succeeded"] %>/<%= t["runs"] %></td></tr>
        <% end %></tbody>
      </table>
      <p class="text-xs text-slate-500">Cheapest first. Check the results matched before moving the task to it.</p>
    <% end %>
  <% else %>
    <p class="text-slate-500">No agent runs reported yet. Agents report each run (model, tokens, time, and <code class="text-xs">trial_of</code> when testing the same task on several models) to <code class="text-xs">POST <%= api_v1_skill_runs_path(s.name) %></code>; the skill's intensity and cost per model appear here.</p>
    <% e = Capture::Estimator.for_step({ "title" => s.title, "instructions" => s.description, "skill_name" => s.name }) %>
    <p class="text-slate-600 mt-2">Until then it's anticipated as <strong><%= Capture::TaskProfile.label(e["nature"]) %></strong>, <%= e["complexity"] %> complexity: about <%= number_with_delimiter(e["tokens"]) %> tokens on <%= Capture::Models.label(e["model"]) %> (<%= number_to_currency(e["cost"], unit: "", precision: 3) %> credits).</p>
    <% if (mr = MacroReview.for_subject("skill", s.name)) %>
      <p class="mt-2"><%= link_to "Macro review: #{mr.verdict_label.downcase} (#{mr.status})", macro_review_path(mr), class: "text-sky-700 hover:underline" %></p>
    <% end %>
  <% end %>
</div>
