<% c = SkillClassification.for(s.name) %>
<% can = policy(s).classify? %>
<div class="bg-white border rounded p-4" id="classification">
  <div class="flex items-baseline justify-between gap-2">
    <h2 class="font-semibold">Classification</h2>
    <%= classification_source(c) %>
  </div>
  <div class="mt-2"><%= render "skills/classification", c: c, show_source: false %></div>
  <% if c&.rationale.present? && !c.confirmed %><p class="text-xs text-slate-500 mt-2">Why: <%= c.rationale %></p><% end %>
  <% if can %>
    <div class="flex flex-wrap gap-2 mt-3">
      <% if c && !c.confirmed && c.field_assignments.any? %><%= button_to "✓ Confirm", confirm_skill_classification_path(s), class: btn_primary %><% end %>
      <%= button_to "✨ Re-infer", reinfer_skill_classification_path(s), class: btn, data: (c&.confirmed ? { turbo_confirm: "Replace the confirmed classification with a new inference?" } : {}) %>
    </div>
    <details class="mt-3">
      <summary class="cursor-pointer text-sky-700">Change fields or apps</summary>
      <% tree_options = Field.tree.map { |fld, d| ["#{"\u00A0\u00A0" * d * 2}#{d.positive? ? '› ' : ''}#{fld.name}", fld.id] } %>
      <%= form_with url: skill_classification_path(s), method: :patch, class: "space-y-3 mt-2" do |f| %>
        <fieldset>
          <legend class="text-sm">Fields <span class="text-xs text-slate-500">(as many as apply; untick to remove)</span></legend>
          <div class="space-y-1 mt-1">
            <% (c&.ordered_fields || []).each do |fld| %>
              <label class="flex items-center gap-1.5 text-sm"><%= check_box_tag "field_ids[]", fld.id, true, id: "field-#{fld.id}" %> <%= fld.label %></label>
            <% end %>
          </div>
        </fieldset>
        <div>
          <%= label_tag :add_field_id, "Add a field" %>
          <%= select_tag :add_field_id, options_for_select(tree_options), include_blank: "Choose…", class: input_css %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div><%= label_tag :new_field_name, "Or create a new field" %><%= text_field_tag :new_field_name, nil, placeholder: "e.g. Hypothesis testing", class: input_css, maxlength: 60 %></div>
          <div><%= label_tag :new_field_parent_id, "Under" %><%= select_tag :new_field_parent_id, options_for_select(tree_options), include_blank: "(top level)", class: input_css %></div>
        </div>
        <fieldset>
          <legend class="text-sm">Apps</legend>
          <% observed = Capture::Classifier.observed_apps(s) %>
          <div class="grid grid-cols-2 gap-1 mt-1">
            <% SkillClassification::APPS.each do |a| %>
              <label class="flex items-center gap-1.5 text-sm">
                <%= check_box_tag "apps[]", a, (c&.apps || observed).include?(a), id: "app-#{a.parameterize}", disabled: observed.include?(a) %>
                <%= a %><%= tag.span("(seen in steps)", class: "text-xs text-slate-400") if observed.include?(a) %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <%= f.submit "Save classification", class: btn_primary %>
        <p class="text-xs text-slate-500">Saved classifications are never overwritten by AI. Apps seen in the skill's steps are always included. New fields join the shared taxonomy.</p>
      <% end %>
    </details>
  <% end %>
</div>
