<% content_for :title, "Library" %>
<div class="mb-4">
  <h1 class="text-2xl font-bold">Skill library</h1>
  <p class="text-sm text-slate-500">Procedures captured from how people actually work. Each one downloads as an Agent Skills <code>SKILL.md</code>.</p>
</div>

<%# Everything that narrows the list lives in one tray: a different material from the
    panels, because choosing what to see is not the same as reading what you found. %>
<div class="panel-tool p-4 mb-4 space-y-3">
<div class="flex flex-wrap items-center justify-between gap-2">
<nav class="flex flex-wrap items-center gap-1 text-sm" aria-label="Level">
  <span class="text-xs text-tool-700/70 mr-1">Level</span>
  <% ([[nil, "All I can see"]] + Skill::LEVEL_LABELS.to_a).each do |lvl, label| %>
    <%= link_to label, skills_path(request.query_parameters.merge(level: lvl, page: nil).compact), class: "px-2.5 py-1 rounded-full transition-colors #{params[:level].to_s == lvl.to_s ? 'bg-slate-900 text-white' : 'text-tool-700 hover:bg-tool-200'}",
          title: { "mine" => "Skills you published, contributed to or asked for", "received" => "Skills coworkers sent you directly", "department" => "Skills by people in your department#{current_user.department.present? ? " (#{current_user.department})" : ' (or your areas)'}", "firm" => "Shared with the whole firm", "industry" => "Promoted to the market, shared with the firm's industry", "global" => "Promoted to the market for everyone" }[lvl] %>
  <% end %>
</nav>
<%= link_to "⇢ Send skills to a coworker", new_transfer_path, class: "text-sm text-sky-700 hover:underline" %>
</div>
<%= form_with url: skills_path, method: :get, class: "flex flex-wrap gap-2 items-end text-sm" do |f| %>
  <%= hidden_field_tag :level, params[:level] if params[:level].present? %>
  <label class="flex flex-col gap-1 flex-1 min-w-48">Search<%= search_field_tag :q, params[:q], placeholder: "Title, description, tag", class: "bg-white border-0 rounded-lg px-2.5 py-1.5 shadow-sm" %></label>
  <label class="flex flex-col gap-1">Field
    <%= select_tag :field, options_for_select(Field.tree.map { |fld, d| ["#{"  " * d * 2}#{d.positive? ? '› ' : ''}#{fld.name}", fld.path] }, params[:field]), include_blank: "All fields", class: "bg-white border-0 rounded-lg px-2.5 py-1.5 shadow-sm" %>
  </label>
  <label class="flex flex-col gap-1">Stage
    <%= select_tag :stage, options_for_select([["All stages", ""], ["🧪 Local (sandbox)", "local"], ["🏢 Firm", "firm"], ["🌐 Market", "market"]], params[:stage]), class: "bg-white border-0 rounded-lg px-2.5 py-1.5 shadow-sm" %>
  </label>
  <label class="flex flex-col gap-1">Area
    <%= select_tag :domain, options_for_select([["All areas", ""]] + @domains.map { |d| [area_name(d), d] }, params[:domain]), class: "bg-white border-0 rounded-lg px-2.5 py-1.5 shadow-sm" %>
  </label>
  <%= hidden_field_tag :app, params[:app] if params[:app].present? %>
  <%= f.submit "Filter", class: "px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-sm hover:bg-slate-700 transition-colors cursor-pointer" %>
<% end %>

<%# The app marks speak for themselves. No borders, no captions: the one you are in is
    the one with a ring around it. %>
<div class="flex flex-wrap items-center gap-2" aria-label="Filter by app">
  <% ring = ->(on) { "rounded-full p-1 transition-shadow duration-200 #{on ? 'shadow-[0_0_0_2px_var(--color-slate-900)]' : 'hover:shadow-[0_0_0_2px_var(--color-tool-200)]'}" } %>

  <%= link_to skills_path(request.query_parameters.except("app", "page")), class: ring.(params[:app].blank?),
        title: "Every app", "aria-label": "Show skills for every app",
        aria: { current: params[:app].blank? ? "true" : nil } do %>
    <span class="grid place-items-center w-7 h-7 rounded-full bg-tool-200 text-tool-700" aria-hidden="true">
      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><circle cx="4" cy="4" r="1.6"/><circle cx="12" cy="4" r="1.6"/><circle cx="4" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/></svg>
    </span>
  <% end %>

  <% SkillClassification::APPS.each do |a| %>
    <% on = params[:app] == a %>
    <%= link_to skills_path(request.query_parameters.except("page").merge("app" => (on ? nil : a)).compact),
          class: ring.(on), title: a, "aria-label": "#{on ? "Stop filtering by" : "Only"} #{a}", aria: { pressed: on } do %>
      <span class="grid place-items-center w-7 h-7 rounded-full text-[10px] font-bold text-white"
            style="background: <%= ApplicationHelper::APP_STYLE[a][1] %>" aria-hidden="true"><%= ApplicationHelper::APP_STYLE[a][0] %></span>
    <% end %>
  <% end %>
</div>
</div>

<% if @field %><p class="text-sm text-slate-600 mb-3">Showing <strong><%= @field.label %></strong> and everything under it.</p><% end %>

<div class="grid md:grid-cols-2 gap-3">
  <% @skills.each do |s| %>
    <article class="panel-soft p-4 flex flex-col gap-2">
      <div class="flex justify-between gap-2">
        <%= link_to s.title, skill_path(s), class: "font-semibold text-sky-700 hover:underline" %>
        <span class="flex gap-1 shrink-0"><%= stage_badge(s.stage) %><% unless s.status == "published" %><%= status_badge(s.status) %><% end %></span>
      </div>
      <div class="font-mono text-xs text-slate-500 break-all"><%= s.name %> · v<%= s.version %><%= " · #{area_name(s.domain)}" if s.domain %></div>
      <p class="text-sm text-slate-700"><%= s.description.truncate(200) %></p>
      <div class="border-t pt-2"><%= render "skills/classification", c: @classifications[s.name], compact: true %></div>
      <% if s.tags.any? %><div class="flex flex-wrap gap-1"><% s.tags.each do |t| %><span class="text-xs bg-slate-100 rounded px-1.5 py-0.5"><%= t %></span><% end %></div><% end %>
    </article>
  <% end %>
</div>
<% if @skills.empty? %>
  <p class="text-sm text-slate-500 panel-soft p-6 text-center">No skills match these filters.</p>
<% end %>
<div class="mt-3"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
