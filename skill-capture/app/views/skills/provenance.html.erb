<% s = @skill %>
<% content_for :title, "Provenance — #{s.title}" %>

<div class="max-w-4xl">
  <p class="text-xs text-slate-500"><%= link_to "Library", skills_path, class: "hover:underline" %> ›
    <%= link_to s.title, skill_path(s), class: "hover:underline" %></p>
  <div class="flex flex-wrap items-start gap-3 mt-1">
    <div>
      <h1 class="text-2xl font-bold">Provenance</h1>
      <p class="text-slate-600 mt-1">What this skill is, and everything that has happened to it. The identity below is
        a hash of the skill's own content, so anyone holding the same bytes computes the same value — including
        someone with no access to this system.</p>
    </div>
    <%= link_to "Manifest (.json)", provenance_skill_path(s, format: :json), class: "#{btn} ml-auto shrink-0",
          title: "Identity, chain and anchors, in a form a counterparty can check" %>
  </div>

  <div class="panel-soft p-4 mt-5">
    <h2 class="font-semibold mb-2">Identity</h2>
    <dl class="grid sm:grid-cols-[9rem_1fr] gap-y-1 text-sm">
      <dt class="text-slate-500">Content hash</dt>
      <dd class="font-mono text-xs break-all"><%= s.content_hash %></dd>
      <dt class="text-slate-500">Covers</dt>
      <dd class="text-slate-600">name, title, description, body, tags, inputs, outputs, workflow, licence</dd>
      <dt class="text-slate-500">Deliberately not</dt>
      <dd class="text-slate-600">stage, votes, traffic, timestamps — promoting a skill does not change the skill</dd>
      <dt class="text-slate-500">Still matches</dt>
      <dd>
        <% if s.content_hash_intact? %>
          <span class="text-emerald-700">✓ the stored hash matches the skill as it is now</span>
        <% else %>
          <span class="text-red-700">⚠ the stored hash does not match this skill's content</span>
        <% end %>
      </dd>
    </dl>
  </div>

  <h2 class="font-semibold mt-6 mb-2">History <span class="text-sm font-normal text-slate-500">(newest first)</span></h2>
  <% if @entries.empty? %>
    <p class="text-sm text-slate-500 panel-soft p-4">Nothing in the chain for this skill yet. Entries are
      written from the moment a skill is published; anything published before the chain existed has none.</p>
  <% else %>
    <ol class="panel-soft divide-y divide-sage-200 text-sm">
      <% @entries.each do |e| %>
        <li class="p-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-medium"><%= { "skill.published" => "Published", "skill.revised" => "Revised",
                                          "skill.branched" => "Branched", "skill.promoted" => "Promoted",
                                          "skill.transferred" => "Sent", "skill.retired" => "Retired" }[e.event] || e.event %></span>
          <% if e.skill_version %><span class="text-slate-500">v<%= e.skill_version %></span><% end %>
          <span class="text-slate-500"><%= nice_time(e.occurred_at) %></span>
          <% if e.payload["to_stage"] %><span class="text-slate-600">→ <%= Skill::STAGE_LABELS[e.payload["to_stage"]] %></span><% end %>
          <% if e.payload["waived"] %><span class="text-amber-700">gate waived</span><% end %>
          <span class="ml-auto flex items-center gap-2 font-mono text-xs">
            <span class="text-slate-400" title="This entry's hash"><%= e.entry_hash.first(10) %></span>
            <span class="<%= e.intact? ? "text-emerald-700" : "text-red-700" %>" title="<%= e.intact? ? "Contents match this entry's hash" : "Contents do not match this entry's hash" %>"><%= e.intact? ? "✓" : "⚠" %></span>
          </span>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% if @anchors.any? %>
    <h2 class="font-semibold mt-6 mb-2">Anchors</h2>
    <p class="text-sm text-slate-600 mb-2">Each day the whole chain is committed to with a single root, written outside
      the database. Once a root is published somewhere we do not control, the history beneath it cannot be changed quietly.</p>
    <ul class="panel-soft divide-y divide-sage-200 text-sm">
      <% @anchors.each do |a| %>
        <li class="p-3 flex flex-wrap items-baseline gap-3">
          <span class="font-medium"><%= a.on_date.strftime("%-d %B %Y") %></span>
          <span class="text-slate-500"><%= pluralize(a.entry_count, "entry") %></span>
          <span class="ml-auto font-mono text-xs text-slate-400"><%= a.root_hash.first(16) %>…</span>
          <span class="font-mono text-xs <%= a.holds? ? "text-emerald-700" : "text-red-700" %>"><%= a.holds? ? "✓ holds" : "⚠ broken" %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @verdict %>
    <div class="mt-6 rounded p-3 text-sm <%= @verdict.ok ? "bg-emerald-50 border border-emerald-200 text-emerald-900" : "bg-red-50 border border-red-200 text-red-900" %>">
      <span class="font-medium">Whole chain:</span> <%= @verdict %><span class="text-xs"> — checked across every skill, not only this one.</span>
    </div>
  <% end %>
</div>
