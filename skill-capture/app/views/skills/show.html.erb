<% s = @skill %>
<% content_for :title, s.title %>
<div class="flex flex-wrap justify-between items-start gap-2 mb-4">
  <div>
    <div class="text-xs text-slate-500 mb-1"><%= link_to "Library", skills_path, class: "hover:underline" %></div>
    <h1 class="text-2xl font-bold"><%= s.title %></h1>
    <div class="mt-1 flex flex-wrap items-center gap-2"><%= stage_badge(s.stage) %><% if Capture::SkillStandard.check_skill(s).clean? %><span class="text-xs text-emerald-700 border border-emerald-200 bg-emerald-50 rounded px-1.5" title="Meets Anthropic's Agent Skills SKILL.md format">✓ Agent Skills format</span><% end %><span class="font-mono text-xs text-slate-500 break-all"><%= s.name %> · v<%= s.version %><%= " · #{s.domain}" if s.domain %> · <%= s.status %></span></div>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Download SKILL.md", download_skill_path(s), class: btn %>
    <% if s.status == "published" && policy(s).update? %><%= link_to "Revise", edit_skill_path(s), class: btn_primary %><% end %>
    <% if s.status == "published" && policy(s).deprecate? %>
      <%= button_to "Deprecate", deprecate_skill_path(s), data: { turbo_confirm: "Deprecate this skill?" }, class: "px-3 py-1.5 rounded text-sm border border-red-300 text-red-700 bg-white" %>
    <% end %>
  </div>
</div>

<% if s.status != "published" && (current = Skill.current(s.name)) %>
  <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded p-3 text-sm mb-4">
    This version is <%= s.status %>. Current: <%= link_to "v#{current.version}", skill_path(current), class: "underline" %>.
  </div>
<% end %>

<div class="grid md:grid-cols-3 gap-4">
  <div class="md:col-span-2 bg-white border rounded p-4">
    <p class="text-sm mb-3"><%= s.description %></p>
    <pre class="whitespace-pre-wrap text-sm bg-slate-50 border rounded p-3"><%= s.body %></pre>
  </div>
  <div class="space-y-4 text-sm">
    <% std = Capture::SkillStandard.check_skill(s) %>
    <% unless std.clean? %><%= render "skills/standard", report: std, compact: true %><% end %>
    <%= render "worksheet_panel", s: s %>
    <%= render "classification_panel", s: s %>
    <%= render "resources_panel", s: s %>
    <%= render "stage_panel", s: s %>
    <%= render "vote_panel", s: s %>
    <%= render "rest_stops_panel", s: s %>
    <div class="bg-white border rounded p-4 space-y-1">
      <h2 class="font-semibold mb-1">Origin</h2>
      <div>Published by <%= s.published_by&.name || "—" %> on <%= nice_time(s.published_at) %></div>
      <% if s.source["contributors"].present? %><div>Captured from work by: <%= Array(s.source["contributors"]).join(", ") %></div><% end %>
      <% if s.source["sources"].present? %><div>Seen in: <%= Array(s.source["sources"]).join(", ") %></div><% end %>
      <% if s.source["occurrences"] %><div>Observed <%= s.source["occurrences"] %>× before capture</div><% end %>
      <% if s.source["draft_generator"] %><div>Drafted by: <%= s.source["draft_generator"] %></div><% end %>
      <% if s.source["change_note"] %><div>Change note: <%= s.source["change_note"] %></div><% end %>
      <% if s.source_candidate && policy(s.source_candidate).show? %><div><%= link_to "Review record", skill_candidate_path(s.source_candidate), class: "text-sky-700 hover:underline" %></div><% end %>
      <div>License: <%= s.license %></div>
    </div>
    <% metric = SkillMetric.for(s.name); bounty = Bounty.active_for(s.name) %>
    <div class="bg-white border rounded p-4">
      <h2 class="font-semibold mb-1">Traffic &amp; price</h2>
      <% if metric&.priced? %>
        <div class="mb-1"><%= tier_badge(metric.tier) %> <span class="text-xs text-slate-500">· index <%= metric.congestion_index %></span></div>
        <dl class="grid grid-cols-[7rem_1fr] gap-y-0.5">
          <dt class="text-slate-500">Price per trip</dt><dd><%= credits(metric.price) %></dd>
          <dt class="text-slate-500">Travel time</dt><dd><%= minutes_text(metric.median_minutes) %> <span class="text-xs text-slate-500">(free-flow <%= minutes_text(metric.freeflow_minutes) %>)</span></dd>
          <dt class="text-slate-500">Wait before</dt><dd><%= minutes_text(metric.median_wait_minutes) %></dd>
          <dt class="text-slate-500">Trips</dt><dd><%= metric.trips %> by <%= metric.people %> <%= "person".pluralize(metric.people) %> in <%= schedule.window_days %> days</dd>
          <dt class="text-slate-500">Delay</dt><dd><%= metric.delay_hours %> h above free-flow</dd>
        </dl>
      <% else %>
        <p class="text-slate-500">Not enough traffic to price yet (needs <%= schedule.min_trips %> trips).</p>
      <% end %>
      <% if bounty %>
        <div class="mt-2 border-t pt-2">
          <div>💰 <strong><%= credits(bounty.pool) %></strong> bounty <span class="text-xs text-slate-500">(<%= bounty.status.humanize.downcase %>)</span></div>
          <% if bounty.status == "open" && s.status == "published" %>
            <%= link_to "Fix this", new_skill_candidate_path(fix: s.name), class: "#{btn_primary} mt-1" %>
          <% end %>
          <%= link_to "See bounties", bounties_path, class: "text-xs text-sky-700 hover:underline ml-1" %>
        </div>
      <% end %>
    </div>
    <% nexts = SkillLink.neighbours(s.name, direction: :next).filter_map { |l| (sk = Skill.current(l[:name])) && sk.visible_to?(current_user) && l.merge(skill: sk) } %>
    <% prevs = SkillLink.neighbours(s.name, direction: :previous).filter_map { |l| (sk = Skill.current(l[:name])) && sk.visible_to?(current_user) && l.merge(skill: sk) } %>
    <% manual_next = SkillLink.manual.where(from_node: s.name).pluck(:to_node) %>
    <div class="bg-white border rounded p-4">
      <div class="flex items-baseline justify-between">
        <h2 class="font-semibold mb-1">On the map</h2>
        <%= link_to "Open map", skill_map_path, class: "text-xs text-sky-700 hover:underline" %>
      </div>
      <% if prevs.any? %>
        <div class="text-xs text-slate-500 mt-1">People arrive from</div>
        <ul class="space-y-0.5"><% prevs.each do |l| %><li><%= link_to l[:skill].title, skill_path(l[:skill]), class: "text-sky-700 hover:underline" %> <span class="text-xs text-slate-500"><%= l[:traffic].positive? ? "#{l[:traffic]} trips" : "linked" %></span></li><% end %></ul>
      <% end %>
      <div class="text-xs text-slate-500 mt-2">People continue with</div>
      <% if nexts.any? %>
        <ul class="space-y-0.5">
          <% nexts.each do |l| %>
            <li class="flex items-baseline gap-1">
              <%= link_to l[:skill].title, skill_path(l[:skill]), class: "text-sky-700 hover:underline" %>
              <span class="text-xs text-slate-500"><%= [l[:traffic].positive? ? "#{l[:traffic]} trips" : nil, l[:manual] ? "linked by a reviewer" : nil].compact.join(" · ") %></span>
              <% if manual_next.include?(l[:name]) && policy(s).update? %>
                <%= button_to "×", skill_link_path(s, l[:name]), method: :delete, class: "text-xs text-slate-400 hover:text-red-700", title: "Remove link", form: { class: "inline" } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-slate-500">Nothing observed yet.</p>
      <% end %>
      <% if s.status == "published" && policy(s).update? %>
        <%= form_with url: skill_links_path(s), method: :post, class: "flex gap-1 mt-2" do %>
          <%= select_tag :to, options_for_select(Skill.published.visible_to(current_user).where.not(name: s.name).order(:title).pluck(:title, :name)), prompt: "Add what comes next…", class: "border rounded px-2 py-1 text-xs flex-1 min-w-0", "aria-label": "Skill that comes next" %>
          <button class="<%= btn %> text-xs">Link</button>
        <% end %>
      <% end %>
    </div>
    <div class="bg-white border rounded p-4">
      <h2 class="font-semibold mb-1">Versions</h2>
      <ul class="space-y-1">
        <% s.versions.each do |v| %>
          <li><%= link_to "v#{v.version}", skill_path(v), class: "text-sky-700 hover:underline #{'font-bold' if v == s}" %> · <%= v.status %> · <%= nice_date(v.published_at) %></li>
        <% end %>
      </ul>
      <% if (origin = s.lineage.drop(1).find { |l| l.name != s.name }) %>
        <h3 class="font-semibold mt-3 mb-1">Forked from</h3>
        <%= link_to "#{origin.name} v#{origin.version}", skill_path(origin), class: "text-sky-700 hover:underline break-all" %>
      <% end %>
      <% forks = s.children.reject { |ch| ch.name == s.name } %>
      <% if forks.any? %>
        <h3 class="font-semibold mt-3 mb-1">Forks</h3>
        <% forks.each do |ch| %><div><%= link_to "#{ch.name} v#{ch.version}", skill_path(ch), class: "text-sky-700 hover:underline break-all" %></div><% end %>
      <% end %>
    </div>
  </div>
</div>
