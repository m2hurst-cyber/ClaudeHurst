<% bp = s.source["worksheet"] %>
<% if bp.is_a?(Hash) %>
  <% keys = Capture::Worksheets.command_keys(bp); cmds = FormulaCommand.where(provider: s.domain, key: keys).index_by(&:key) %>
  <div class="panel-soft p-4" id="worksheet">
    <div class="flex items-baseline justify-between gap-2">
      <h2 class="font-semibold">▦ Worksheet</h2>
      <span class="text-xs text-slate-500"><%= (bp["kind"] || "table").capitalize %> · <%= area_name(s.domain) %></span>
    </div>
    <ul class="mt-1 text-xs text-slate-600 list-disc ml-4"><% Capture::Worksheets.outline(bp).each do |l| %><li><%= l %></li><% end %></ul>
    <% if bp["source"] && (src = Skill.current(bp["source"])) %><div class="text-xs mt-1">Reads <%= link_to src.title, skill_path(src), class: "text-sky-700 hover:underline" %></div><% end %>
    <% if keys.any? %>
      <div class="text-xs text-slate-500 mt-2 mb-1">Formulas (<%= keys.count { |k| cmds[k]&.status == "verified" } %> of <%= keys.size %> verified)</div>
      <ul class="space-y-0.5 text-xs">
        <% keys.each do |k| %>
          <% c = cmds[k] %>
          <li class="flex items-baseline gap-1">
            <span class="<%= c&.status == 'verified' ? 'text-emerald-700' : 'text-amber-700' %>"><%= c&.status == "verified" ? "✓" : "◌" %></span>
            <%= link_to (c&.name || k), formulas_path(provider: s.domain, q: k, anchor: c && "cmd-#{c.id}"), class: "text-sky-700 hover:underline" %>
            <code class="text-slate-400 truncate" title="<%= c&.syntax %>"><%= c&.sample %></code>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="text-xs text-slate-500 mt-2">Build it in Excel: Skill Capture tab › Library › this skill › <strong>Build worksheet</strong>.</p>
  </div>
<% end %>
