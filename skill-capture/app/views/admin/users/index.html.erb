<% content_for :title, "People" %>
<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">People</h1>
  <%= link_to "Add person", new_admin_user_path, class: btn_primary %>
</div>
<div class="panel-soft overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-100"><tr><th class="px-3 py-2 text-left">Name</th><th class="px-3 py-2 text-left">Email</th><th class="px-3 py-2 text-left">Role</th><th class="px-3 py-2 text-left">Reviews areas</th><th class="px-3 py-2 text-left">Active</th></tr></thead>
    <tbody class="divide-y">
      <% @users.each do |u| %>
        <tr>
          <td class="px-3 py-2"><%= link_to u.name, edit_admin_user_path(u), class: "text-signal-700 hover:underline" %></td>
          <td class="px-3 py-2"><%= u.email %></td>
          <td class="px-3 py-2"><%= u.role %></td>
          <td class="px-3 py-2"><%= u.admin? ? "all" : (u.domains.join(", ").presence || "—") %></td>
          <td class="px-3 py-2"><%= u.active? ? "yes" : "no" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
