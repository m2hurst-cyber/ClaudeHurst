<%= form_with(model: [:admin, user], class: "space-y-3 bg-white p-4 rounded border max-w-xl") do |f| %>
  <% if user.errors.any? %><div class="bg-red-50 border border-red-200 text-red-800 p-2 rounded text-sm"><%= user.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :name %><%= f.text_field :name, class: input_css %></div>
  <div><%= f.label :email %><%= f.email_field :email, class: input_css %></div>
  <div>
    <%= f.label :role %><%= f.select :role, User::ROLES, {}, class: input_css %>
    <p class="text-xs text-slate-500">Members browse skills and request new ones. Reviewers also approve skills in their areas. Admins do everything.</p>
  </div>
  <div><%= f.label :domains, "Areas reviewed (comma separated)" %><%= f.text_field :domains, value: user.domains.join(", "), placeholder: "finance, sales-ops", class: input_css %></div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :active %> Active</label>
  <%= f.submit class: btn_primary %>
<% end %>
