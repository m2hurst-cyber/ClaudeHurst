<% content_for :title, "Actions" %>
<h1 class="text-2xl font-bold mb-1">Actions</h1>
<p class="text-sm text-slate-500 mb-4">What each reported action means. Labels appear in reviews and drafts, and are what the LLM sees. Areas route review to the right people.</p>
<div class="panel-soft overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-100"><tr><th class="px-3 py-2 text-left">Action key</th><th class="px-3 py-2 text-left">Label</th><th class="px-3 py-2 text-left">Area</th></tr></thead>
    <tbody class="divide-y">
      <% @definitions.each do |d| %>
        <tr>
          <td class="px-3 py-2 font-mono text-xs break-all"><%= d.key %></td>
          <td class="px-3 py-2"><%= link_to d.label, edit_admin_action_definition_path(d), class: "text-sky-700 hover:underline" %></td>
          <td class="px-3 py-2"><%= d.domain || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
