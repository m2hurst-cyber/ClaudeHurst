<% content_for :title, "Audit" %>
<h1 class="text-2xl font-bold mb-4">Audit log</h1>
<%= form_with url: admin_audit_logs_path, method: :get, class: "panel-tool p-3 mb-4 flex flex-wrap gap-2 items-center" do |f| %>
  <%= search_field_tag :q, params[:q], placeholder: "Action prefix, e.g. skill.", class: "border rounded px-2 py-1.5 text-sm w-72" %>
  <%= f.submit "Filter", class: btn %>
<% end %>
<div class="panel-soft overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-slate-100"><tr><th class="px-3 py-2 text-left">When</th><th class="px-3 py-2 text-left">Who</th><th class="px-3 py-2 text-left">Action</th><th class="px-3 py-2 text-left">Subject</th><th class="px-3 py-2 text-left">Details</th></tr></thead>
    <tbody class="divide-y">
      <% @logs.each do |l| %>
        <tr>
          <td class="px-3 py-2 whitespace-nowrap"><%= nice_time(l.created_at) %></td>
          <td class="px-3 py-2"><%= l.user&.name || l.source&.name || "system" %></td>
          <td class="px-3 py-2 font-mono text-xs"><%= l.action %></td>
          <td class="px-3 py-2 text-slate-500"><%= [l.subject_type, l.subject_id].compact.join("#") %></td>
          <td class="px-3 py-2 text-xs text-slate-500 max-w-md truncate"><%= l.metadata.to_json %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
