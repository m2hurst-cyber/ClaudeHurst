<% content_for :title, "Protocols" %>
<h1 class="text-2xl font-bold mb-1">Protocols &amp; triggers</h1>
<p class="text-sm text-slate-500 mb-4">When Skill Capture prompts people to save, extend or branch their work, and how rest stops (restorable snapshots) are kept. Triggers look only at each person's own add-in activity; accepting a prompt sends a draft to the area's reviewers.</p>
<% desc = {
     "save" => "Someone repeats a workflow that no skill or candidate covers.",
     "extend" => "Someone finishes a skill and then does the same extra steps, again and again.",
     "branch" => "Someone starts and finishes a skill but does the middle differently, again and again.",
     "evaluation" => "Triggers run in the background for each person at most this often, so the AI has time to judge what it found. A pattern is shown to the person only if the AI (or, without an AI key, the rules) calls it a real skill with at least this confidence; it suggests the kind, a name and an Agent Skills description. Patterns it passes over are looked at again once they've happened twice as often. Untick Enabled to judge with the rules only (no AI calls).",
     "rest_stop" => "Snapshots are taken before and after every change and when a branch starts; these settings add a daily one and limit how many automatic ones are kept. Manual, pinned and branch-start rest stops are never pruned."
   } %>
<% names = { "min_repeats" => "Times seen", "min_steps" => "At least (steps)", "lookback_days" => "Look back (days)", "snooze_days" => "\"Not now\" snoozes (days)",
             "max_added_steps" => "Up to (added steps)", "max_extra_steps" => "Up to (extra steps)", "daily" => "Daily rest stop when a skill changed", "keep_auto" => "Keep automatic (per skill)",
             "interval_minutes" => "Check each person every (minutes)", "min_confidence" => "Minimum AI confidence (0-100)" } %>
<%= form_with url: admin_protocols_path, method: :patch, class: "space-y-4 max-w-3xl text-sm" do %>
  <% if @protocols.any? { |p| p.errors.any? } %>
    <div class="bg-red-50 border border-red-200 text-red-800 p-2 rounded"><%= @protocols.flat_map { |p| p.errors.full_messages.map { |m| "#{p.label}: #{m}" } }.to_sentence %></div>
  <% end %>
  <%# Granularity gets its own control: it is a slider, not a box of numbers. %>
  <% g = @protocols.find { |x| x.key == "granularity" } %>
  <% level = g["level"].to_i %>
  <fieldset class="bg-white border rounded p-4" data-controller="granularity"
            data-granularity-preview-url-value="<%= preview_admin_protocols_path %>">
    <legend class="px-1 font-semibold">📏 Granularity</legend>
    <p class="text-slate-500 mb-3">How finely work is cut into skills. This moves five things at once: how long a
      skill may be, whether the small reusable unit or the whole story wins when one sits inside the other, how much
      repetition counts as evidence, how varied a pattern's surroundings must be, and what the AI is told to prefer.</p>

    <p class="mb-3"><%= link_to "Read the directions each setting gives the agents →", agent_directions_path, class: "underline" %></p>
    <input type="range" min="1" max="5" step="1" value="<%= level %>" class="w-full accent-teal-700"
           name="protocols[granularity][level]" id="protocols_granularity_level"
           data-granularity-target="slider" data-action="input->granularity#change">
    <div class="flex justify-between text-xs text-slate-500 mt-1 mb-3">
      <% Capture::Granularity::LEVELS.each do |n, s| %>
        <span class="text-center w-1/5 <%= "font-semibold text-slate-900" if n == level %>" data-granularity-target="tick" data-level="<%= n %>"><%= s[:label] %></span>
      <% end %>
    </div>

    <div class="rounded bg-slate-50 border p-3 mb-3">
      <p class="font-medium" data-granularity-target="blurb"><%= Capture::Granularity::LEVELS[level][:blurb] %></p>
      <p class="text-slate-500 mt-1" data-granularity-target="detail"></p>
      <p class="text-slate-500 mt-2" data-granularity-target="cost">Checking what this would have found…</p>
    </div>

    <% if @areas.any? %>
      <p class="font-medium mb-1">By area</p>
      <p class="text-slate-500 mb-2">Areas that want a different size. Tax may want whole returns where research wants reusable blocks.</p>
      <div class="grid sm:grid-cols-3 gap-2">
        <% @areas.each do |area| %>
          <% current = @overrides.find { |o| o.scope_key == area }&.level %>
          <label class="flex items-center gap-2">
            <span class="w-28 truncate" title="<%= area %>"><%= area.humanize %></span>
            <%= select_tag "granularity_by_area[#{area}]",
                  options_for_select([["Firm default", ""]] + Capture::Granularity::LEVELS.map { |n, s| [s[:label], n] }, current),
                  class: input_css %>
          </label>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <% @protocols.reject { |x| x.key == "granularity" }.each do |p| %>
    <fieldset class="bg-white border rounded p-4">
      <legend class="px-1 font-semibold"><%= { "save" => "💾", "extend" => "➕", "branch" => "⑂", "rest_stop" => "🅿", "evaluation" => "✨" }[p.key] %> <%= p.label %></legend>
      <p class="text-slate-500 mb-2"><%= desc[p.key] %></p>
      <label class="flex items-center gap-2 mb-2"><%= hidden_field_tag "protocols[#{p.key}][enabled]", "0", id: nil %><%= check_box_tag "protocols[#{p.key}][enabled]", "1", p.enabled %> Enabled</label>
      <div class="grid sm:grid-cols-4 gap-3">
        <% Protocol::DEFAULTS[p.key].each do |name, default| %>
          <% if default == true || default == false %>
            <label class="flex items-center gap-2 sm:col-span-2"><%= hidden_field_tag "protocols[#{p.key}][#{name}]", "0", id: nil %><%= check_box_tag "protocols[#{p.key}][#{name}]", "1", p[name] %> <%= names[name] %></label>
          <% else %>
            <div><%= label_tag "protocols_#{p.key}_#{name}", names[name] %><%= number_field_tag "protocols[#{p.key}][#{name}]", p[name], id: "protocols_#{p.key}_#{name}", class: input_css %></div>
          <% end %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <%= submit_tag "Save protocols", class: btn_primary %>
<% end %>
