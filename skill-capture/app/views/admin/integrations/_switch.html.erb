<%= button_to admin_integration_path(integration, enabled: !integration.enabled?), method: :patch,
      class: "group", "aria-label": "Turn #{integration.name} #{integration.enabled? ? 'off' : 'on'}",
      "aria-pressed": integration.enabled?.to_s do %>
  <span class="relative inline-flex items-center w-[62px] h-[32px] rounded-full p-[3px] transition-colors duration-200
               <%= integration.enabled? ? "bg-verified-600" : "bg-slate-300 group-hover:bg-slate-400" %>">
    <span class="absolute inset-y-0 flex items-center text-[11px] font-semibold tracking-wide
                 <%= integration.enabled? ? "left-2.5 text-white" : "right-2.5 text-slate-600" %>">
      <%= integration.enabled? ? "on" : "off" %>
    </span>
    <span class="relative block w-[26px] h-[26px] rounded-full bg-white shadow-knob transition-transform duration-200
                 <%= "translate-x-[30px]" if integration.enabled? %>"></span>
  </span>
<% end %>
